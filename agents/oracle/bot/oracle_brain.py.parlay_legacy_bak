#!/usr/bin/env python3
"""
oracle_brain.py — Claude API analyst for Oracle sports betting.

Calls Claude Sonnet 4.6 with web_search to analyze Odds API data,
search linemate.com, check injuries/weather/sharp money, and return
EV+ picks with Kelly sizing and Linemate context.

Usage:
    from oracle_brain import analyze_games
    result = analyze_games(odds_data, yesterday_results, bankroll)
    # result = {"date": ..., "analysis_summary": ..., "picks": [...], "parlays": [...], "_meta": {...}}
"""

import anthropic
import json
import os
import re
from datetime import datetime, timezone

LOG_PATH  = '/root/.openclaw/logs/oracle_api_costs.json'
MODEL     = 'claude-sonnet-4-6'
MAX_TOKENS = 4096

SPORT_LABELS = {
    'basketball_nba':    'NBA',
    'americanfootball_nfl': 'NFL',
    'baseball_mlb':      'MLB',
    'icehockey_nhl':     'NHL',
    'basketball_ncaab':  'NCAAB',
}

SYSTEM_PROMPT = """You are Oracle, an elite sports betting analyst for JCF HQ. \
Your job is to find positive expected value bets using data from multiple sources.

PROCESS:
1. Review the odds data provided for today's games
2. Use web search to check linemate.com for each game — \
look for consensus picks, trend data, and 100% club picks
3. Search for injury reports, lineup changes, and late \
scratches for each game
4. Search for weather conditions for outdoor games
5. Search for sharp money indicators and reverse line \
movement
6. Devig the sharpest book's line to find true probability
7. Compare true probability to available odds — only \
recommend bets with positive expected value
8. Apply Kelly criterion for sizing (capped at 3% of bankroll)

RULES:
- Maximum odds: -300 (no heavy favorites)
- Minimum EV: +1.5% to recommend a straight bet
- Soft parlays: 2-4 legs, combined odds -175 or better, \
  max 2 parlays per day
- "No bet" is always valid — capital preservation on \
  efficient pricing days
- Focus on your highest win-rate sport after 8+ picks \
  of historical data
- Always state your confidence level (low/medium/high)
- Always state the key factor driving each pick

OUTPUT FORMAT (respond in valid JSON only, no markdown):
{
  "date": "YYYY-MM-DD",
  "analysis_summary": "2-3 sentence market overview",
  "picks": [
    {
      "sport": "NBA",
      "game": "Team A vs Team B",
      "pick": "Team A -3.5",
      "odds": -110,
      "book": "DraftKings",
      "ev_pct": 3.2,
      "confidence": "high",
      "key_factor": "Linemate 78% consensus + sharp money",
      "kelly_stake_pct": 2.1,
      "stake_amount": 10.50,
      "type": "straight",
      "linemate_data": "78% of models favor Team A"
    }
  ],
  "parlays": [
    {
      "legs": ["Team A -3.5", "Game 2 Over 215"],
      "combined_odds": "+165",
      "stake_amount": 5.00,
      "type": "parlay"
    }
  ]
}

If no positive EV bets exist today, return:
{"date": "YYYY-MM-DD", "analysis_summary": "...", "picks": [], "parlays": []}"""


# ─── Odds formatter ────────────────────────────────────────────────────────────

def _format_odds_compact(odds_data: list) -> str:
    """Format Odds API game data as compact text to reduce token usage."""
    lines = []
    for game in odds_data:
        sport   = SPORT_LABELS.get(game.get('sport_key', ''), game.get('sport_key', ''))
        away    = game.get('away_team', '')
        home    = game.get('home_team', '')
        time_   = game.get('commence_time', '')[:16]
        game_id = game.get('id', '')[:8]
        lines.append(f"\n{sport}: {away} @ {home} | {time_} UTC | id:{game_id}")

        for mk in ('h2h', 'spreads', 'totals'):
            # Collect best odds per outcome (highest price across books)
            best: dict = {}
            book_of: dict = {}
            for bm in game.get('bookmakers', []):
                for market in bm.get('markets', []):
                    if market['key'] != mk:
                        continue
                    for outcome in market['outcomes']:
                        name  = outcome['name']
                        point = outcome.get('point')
                        if mk == 'spreads' and point is not None:
                            sign = '+' if point >= 0 else ''
                            name = f"{name} {sign}{point}"
                        elif mk == 'totals' and point is not None:
                            name = f"{name} {point}"
                        price = outcome.get('price', 0)
                        if name not in best or price > best[name]:
                            best[name]    = price
                            book_of[name] = bm.get('title', bm.get('key', '?'))

            if best:
                parts = [f"{n}: {best[n]} ({book_of[n]})"
                         for n in list(best.keys())[:6]]
                lines.append(f"  [{mk.upper()}] {' | '.join(parts)}")

    return '\n'.join(lines)


# ─── Cost tracking ─────────────────────────────────────────────────────────────

def _load_costs() -> list:
    try:
        with open(LOG_PATH) as f:
            return json.load(f)
    except Exception:
        return []


def _save_cost(input_tokens: int, output_tokens: int, web_searches: int) -> float:
    """Append run cost to oracle_api_costs.json and return cost_usd."""
    cost_usd = round(
        (input_tokens  * 3  / 1_000_000) +
        (output_tokens * 15 / 1_000_000),
        6,
    )
    entry = {
        "date":          datetime.now(timezone.utc).strftime('%Y-%m-%d'),
        "timestamp":     datetime.now(timezone.utc).isoformat(),
        "input_tokens":  input_tokens,
        "output_tokens": output_tokens,
        "web_searches":  web_searches,
        "cost_usd":      cost_usd,
    }
    costs = _load_costs()
    costs.append(entry)
    try:
        with open(LOG_PATH, 'w') as f:
            json.dump(costs, f, indent=2)
    except Exception as e:
        print(f'[brain] cost log write error: {e}')
    return cost_usd


# ─── Main analysis function ────────────────────────────────────────────────────

def _extract_json(text: str) -> dict | None:
    """
    Try multiple strategies to extract a JSON object from Claude's response text.
    Handles: raw JSON, markdown code blocks (```json ... ```), or JSON embedded in prose.
    Returns the parsed dict or None.
    """
    if not text or not text.strip():
        return None

    # Strategy 1: direct parse (model returned clean JSON)
    try:
        return json.loads(text.strip())
    except json.JSONDecodeError:
        pass

    # Strategy 2: markdown ```json``` or ``` block
    code_match = re.search(r'```(?:json)?\s*(\{[\s\S]*?\})\s*```', text)
    if code_match:
        try:
            return json.loads(code_match.group(1))
        except json.JSONDecodeError:
            pass

    # Strategy 3: find the last top-level {...} block in the text
    # (handles "analysis text ... \n\n{json}")
    brace_depth   = 0
    json_start    = -1
    last_complete = None
    for i, ch in enumerate(text):
        if ch == '{':
            if brace_depth == 0:
                json_start = i
            brace_depth += 1
        elif ch == '}':
            brace_depth -= 1
            if brace_depth == 0 and json_start != -1:
                candidate = text[json_start:i + 1]
                try:
                    last_complete = json.loads(candidate)
                except json.JSONDecodeError:
                    pass

    return last_complete


def analyze_games(odds_data: list, yesterday_results: list, bankroll: float) -> dict:
    """
    Analyze today's games using Claude with web search.

    Args:
        odds_data:         List of game dicts from the Odds API (all sports combined).
        yesterday_results: List of recently resolved picks (from oracle_resolved.json).
        bankroll:          Current bankroll balance.

    Returns:
        Dict with keys: date, analysis_summary, picks, parlays, _meta.
        picks and parlays are in the JSON format specified in the system prompt.
    """
    client = anthropic.Anthropic()
    today  = datetime.now(timezone.utc).strftime('%Y-%m-%d')

    odds_text = _format_odds_compact(odds_data) if odds_data else '(no games available today)'

    # Trim recent results — last 15 entries for context
    recent = yesterday_results[-15:] if len(yesterday_results) > 15 else yesterday_results
    recent_text = json.dumps(recent, indent=2, default=str)[:2000]

    user_message = (
        f"Today: {today} | Bankroll: ${bankroll:.2f}\n\n"
        f"AVAILABLE ODDS ({len(odds_data)} games):\n{odds_text}\n\n"
        f"RECENT RESULTS (last {len(recent)} picks):\n{recent_text}\n\n"
        "Use web_search to check linemate.com for each game, search for injury "
        "reports, weather (outdoor games), and sharp money / reverse line movement. "
        "After researching, output ONLY valid JSON — no markdown, no prose outside "
        "the JSON object."
    )

    print(f'[brain] Calling {MODEL} — {len(odds_data)} games...')

    messages = [{"role": "user", "content": user_message}]

    response = client.messages.create(
        model=MODEL,
        max_tokens=MAX_TOKENS,
        system=SYSTEM_PROMPT,
        tools=[{"type": "web_search_20250305", "name": "web_search"}],
        messages=messages,
    )

    # Count web search invocations — web_search_20250305 is server-side so it may
    # appear as 'tool_use' (name='web_search'), 'server_tool_use', or 'web_search_tool_result'
    web_searches = sum(
        1 for block in response.content
        if getattr(block, 'type', '') in ('tool_use', 'server_tool_use')
        and 'web_search' in getattr(block, 'name', '')
    ) or sum(
        1 for block in response.content
        if 'web_search' in getattr(block, 'type', '')
    )

    # Accumulate token usage across turns
    total_input  = response.usage.input_tokens
    total_output = response.usage.output_tokens

    print(
        f'[brain] Turn 1 — {total_input} in + {total_output} out | '
        f'{web_searches} web searches'
    )

    # Extract the last text block from the first response
    result_text = ''
    for block in response.content:
        if getattr(block, 'type', '') == 'text' and block.text:
            result_text = block.text  # last text block wins

    # Try to parse JSON from the first response
    result = _extract_json(result_text)

    # ── Fallback turn: if no JSON found, send a follow-up forcing JSON output ──
    if result is None and result_text:
        print('[brain] No JSON in turn 1 — requesting JSON-only follow-up...')

        # Build the conversation history so far
        turn1_content = response.content  # include all content blocks (tool use, text, etc.)
        follow_up_messages = messages + [
            {"role": "assistant", "content": turn1_content},
            {
                "role": "user",
                "content": (
                    "Your analysis is complete. Now output ONLY the final JSON object "
                    "with your picks — no prose, no markdown, no explanation. "
                    "Start your response with { and end with }."
                ),
            },
        ]

        response2 = client.messages.create(
            model=MODEL,
            max_tokens=MAX_TOKENS,
            system=SYSTEM_PROMPT,
            tools=[{"type": "web_search_20250305", "name": "web_search"}],
            messages=follow_up_messages,
        )

        total_input  += response2.usage.input_tokens
        total_output += response2.usage.output_tokens

        result_text2 = ''
        for block in response2.content:
            if getattr(block, 'type', '') == 'text' and block.text:
                result_text2 = block.text

        print(f'[brain] Turn 2 — {response2.usage.input_tokens} in + '
              f'{response2.usage.output_tokens} out')

        result = _extract_json(result_text2)
        if result is None:
            print(f'[brain] Turn 2 snippet:\n{result_text2[:400]}')

    # Token costs (both turns combined)
    cost_usd = _save_cost(total_input, total_output, web_searches)

    print(
        f'[brain] Total — {total_input} in + {total_output} out | '
        f'{web_searches} web searches | ${cost_usd:.4f}'
    )

    if result is None:
        print('[brain] No valid JSON after 2 turns — returning empty result')
        result = {
            "date":             today,
            "analysis_summary": "Oracle Brain returned no parseable JSON today.",
            "picks":            [],
            "parlays":          [],
        }

    # Attach metadata
    result["_meta"] = {
        "input_tokens":   total_input,
        "output_tokens":  total_output,
        "web_searches":   web_searches,
        "cost_usd":       cost_usd,
        "model":          MODEL,
        "games_analyzed": len(odds_data),
    }

    picks_n   = len(result.get("picks", []))
    parlays_n = len(result.get("parlays", []))
    print(f'[brain] Result: {picks_n} picks, {parlays_n} parlays | '
          f'{result.get("analysis_summary", "")[:120]}')

    return result
