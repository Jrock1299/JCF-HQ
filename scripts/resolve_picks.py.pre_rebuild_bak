#!/root/.openclaw/venv/bin/python
import os
import re
import json
import requests
from datetime import datetime, timezone, timedelta

PICKS_PATH = "/root/.openclaw/dashboard/oracle_picks.json"
CAP_INTEL_PATH = "/root/.openclaw/dashboard/capper_intel.json"
ORACLE_BANKROLL_PATH = "/root/.openclaw/dashboard/oracle_bankroll.json"
RESOLVED_PATH = "/root/.openclaw/dashboard/oracle_resolved.json"

API_BASE = "https://www.thesportsdb.com/api/v1/json/3"
KEYWORDS_PUSH = {"P", "PUSH", "VOID"}


def load_env():
    try:
        with open("/etc/environment", "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                v = v.strip().strip('"')
                if k and k not in os.environ:
                    os.environ[k] = v
    except Exception:
        pass


def send_alert(message: str):
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat_id = os.environ.get("TELEGRAM_ALERT_CHAT_ID") or "797062420"
    if not token:
        return
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    payload = {"chat_id": chat_id, "text": message, "parse_mode": "HTML", "disable_web_page_preview": True}
    requests.post(url, json=payload, timeout=20)


def load_picks():
    if not os.path.exists(PICKS_PATH):
        return []
    with open(PICKS_PATH, "r") as f:
        data = json.load(f)
        if isinstance(data, list):
            return data
        if isinstance(data, dict):
            return data.get("picks", [])
        return []


def save_picks(picks):
    with open(PICKS_PATH, "w") as f:
        json.dump(picks, f, indent=2)


def load_oracle_bankroll():
    if not os.path.exists(ORACLE_BANKROLL_PATH):
        return {"balance": 500.00, "starting": 500.00}
    with open(ORACLE_BANKROLL_PATH, "r") as f:
        return json.load(f)


def save_oracle_bankroll(data):
    with open(ORACLE_BANKROLL_PATH, "w") as f:
        json.dump(data, f, indent=2)


