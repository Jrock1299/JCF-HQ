def normalize_team(team: str, sport: str | None = None) -> str:
    t = team.strip().upper()
    if sport:
        s = sport.upper()
        if s in ("NBA",):
            return NBA_ALIASES.get(t, team)
        if s in ("MLB", "BASEBALL"):
            return MLB_ALIASES.get(t, team)
        if s in ("NHL", "ICE HOCKEY"):
            return NHL_ALIASES.get(t, team)
        if s in ("CBB", "NCAAB", "COLLEGE BASKETBALL"):
            return CBB_ALIASES.get(t, team)
    return NBA_ALIASES.get(t, team)


def parse_pick(pick_str: str):
    # Very simple parsing: "Team ML" or "Team -4.5" / "Team +4.5"
    t = (pick_str or "").strip()
    m = re.match(r"(.+?)\s+(ML|[+-]\d+(?:\.\d+)?)$", t, re.IGNORECASE)
    if not m:
        return t if t else None, "ML"
    team = m.group(1).strip()
    line = m.group(2).upper()
    return team, line


def get_events_by_date(date_str: str, sport: str):
    # sport mapping for TheSportsDB
    sport_map = {
        "NBA": "Basketball",
        "NHL": "Ice Hockey",
        "MLB": "Baseball",
        "NFL": "American Football",
        "NCAAB": "Basketball",
    }
    sport_name = sport_map.get(sport.upper(), sport)
    url = f"{API_BASE}/eventsday.php"
    params = {"d": date_str, "s": sport_name}
    resp = requests.get(url, params=params, timeout=20)
    resp.raise_for_status()
    data = resp.json()
    return data.get("events") or []


def get_events_by_search(team_name: str, date_str: str):
    url = f"{API_BASE}/searchevents.php"
    params = {"e": team_name, "d": date_str}
    resp = requests.get(url, params=params, timeout=20)
    resp.raise_for_status()
    data = resp.json()
    return data.get("event") or []


def resolve_pick(pick, events):
    team, line = parse_pick(pick["pick"])
    if not team:
        return None
    # clean team name for matching (drop mascot/last word)
    words = team.split()
    clean_team = " ".join(words[:-1]) if len(words) > 1 else team
    team = normalize_team(clean_team, pick.get("sport"))

    # find matching event by team name
    for e in events:
        home = (e.get("strHomeTeam") or "").lower()
        away = (e.get("strAwayTeam") or "").lower()
        event_name = (e.get("strEvent") or "").lower()
        if team.lower() not in home and team.lower() not in away and team.lower() not in event_name:
            continue

        # get scores
        try:
            home_score = int(e.get("intHomeScore"))
            away_score = int(e.get("intAwayScore"))
        except Exception:
            return None

        # determine win/loss
        if line == "ML":
            if team.lower() in home:
                return "W" if home_score > away_score else ("P" if home_score == away_score else "L")
            if team.lower() in away:
                return "W" if away_score > home_score else ("P" if home_score == away_score else "L")
        else:
            spread = float(line)
            if team.lower() in home:
                adjusted = home_score + spread
                if adjusted > away_score:
                    return "W"
                if adjusted < away_score:
                    return "L"
                return "P"
            if team.lower() in away:
                adjusted = away_score + spread
                if adjusted > home_score:
                    return "W"
                if adjusted < home_score:
                    return "L"
                return "P"

    return None


def update_capper_intel(picks):
    stats = {}
    for p in picks:
        capper = p.get("capper") or "Unknown"
        res = (p.get("result") or "PENDING").upper()
        s = stats.setdefault(capper, {"W": 0, "L": 0, "P": 0, "PENDING": 0})
        if res in ("W", "L", "P"):
            s[res] += 1
        else:
            s["PENDING"] += 1

    with open(CAP_INTEL_PATH, "w") as f:
        json.dump({"updated_at": datetime.now(timezone.utc).isoformat(), "cappers": stats}, f, indent=2)


def calc_pnl(stake, odds_str, result):
    try:
        odds = float(str(odds_str).replace('%','').strip())
    except Exception:
        odds = -110

    if result == "W":
        if odds > 0:
            return round(stake * (odds / 100), 2)
        else:
            return round(stake / (abs(odds) / 100), 2)
    elif result == "L":
        return -round(stake, 2)
    return 0


def claude_resolve_stale(stale_picks):
    """
    Fallback resolver using Claude Sonnet with web_search for picks that
    TheSportsDB couldn't match and that are >=24h old. More reliable for
    parlays, alt lines, and smaller leagues where TheSportsDB is incomplete.

    Returns a dict: { pick_id_or_index: {"result": "W"|"L"|"P", "note": "..."} }
    """
    if not stale_picks:
        return {}
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        print("[claude_resolve] ANTHROPIC_API_KEY not set — skipping")
        return {}
    try:
        import anthropic
    except Exception as e:
        print(f"[claude_resolve] anthropic sdk not available: {e}")
        return {}

    client = anthropic.Anthropic()
    results = {}
    for idx, p in stale_picks:
        pick_str = p.get("pick", "")
        sport    = p.get("sport", "")
        date     = str(p.get("date", ""))[:10]
        is_parlay = (p.get("type") == "parlay") or ("PARLAY" in (pick_str or "").upper())
        legs_ctx = ""
        if is_parlay:
            legs = p.get("leg_labels") or [l.get("pick", "") for l in (p.get("legs") or [])]
            if legs:
                legs_ctx = "Legs: " + "; ".join(legs)

        prompt = (
            f"Resolve this sports bet from {date} ({sport}). "
            f"Pick: {pick_str}. {legs_ctx}\n"
            "Use web_search to find the final score(s). "
            "For a parlay, all legs must hit for WIN. Any loss = LOSS. "
            "If any leg pushed and others hit, it's still a WIN on the reduced parlay "
            "(but for simplicity, treat push-only outcomes as PUSH). "
            "Respond in valid JSON only: "
            '{"result": "W"|"L"|"P"|"UNKNOWN", "note": "one-sentence evidence"}'
        )
        try:
            resp = client.messages.create(
                model="claude-sonnet-4-6",
                max_tokens=1024,
                tools=[{"type": "web_search_20250305", "name": "web_search"}],
                messages=[{"role": "user", "content": prompt}],
            )
            text = ""
            for blk in resp.content:
                if getattr(blk, "type", "") == "text" and blk.text:
                    text = blk.text
            m = re.search(r"\{[\s\S]*?\}", text)
            if not m:
                continue
            parsed = json.loads(m.group(0))
            res = (parsed.get("result") or "").upper()
            if res in ("W", "L", "P"):
                results[idx] = {"result": res, "note": parsed.get("note", "")}
                print(f"[claude_resolve] {pick_str[:60]} → {res}")
        except Exception as e:
            print(f"[claude_resolve] error for pick idx={idx}: {e}")
    return results


def main():
    load_env()
    picks = load_picks()
    pending = [p for p in picks if (p.get("result") or "").upper() == "PENDING"]

    bankroll = load_oracle_bankroll() or 500
    if isinstance(bankroll, (int, float)):
        bankroll = {"balance": bankroll, "starting": bankroll}
    if "balance" not in bankroll:
        bankroll["balance"] = 500
        bankroll.setdefault("starting", 500)
    daily_stake = round(bankroll.get("balance", 500) * 0.02, 2)

    resolved = []
    for p in pending:
        date_str = p.get("date")
        if not date_str:
            continue
        try:
            words = (p.get("pick") or "").split()
            team_query = " ".join(words[:-1]) if len(words) > 1 else (p.get("pick") or "")
            events = get_events_by_search(team_query.strip(), date_str[:10])
        except Exception:
            continue
        res = resolve_pick(p, events)
        if res:
            p["result"] = res
            p["resolved_at"] = datetime.now(timezone.utc).isoformat()
            p["pnl"] = calc_pnl(daily_stake, p.get("odds", "-110"), res)
            resolved.append(p)

    # ── Claude brain fallback for stale (>=24h) still-pending picks ───────────
    now_utc = datetime.now(timezone.utc)
    stale_pending = []
    for i, p in enumerate(picks):
        if (p.get("result") or "").upper() != "PENDING":
            continue
        date_str = str(p.get("date") or "")[:10]
        if not date_str:
            continue
        try:
            dt = datetime.fromisoformat(date_str).replace(tzinfo=timezone.utc)
        except Exception:
            continue
        if (now_utc - dt) >= timedelta(hours=24):
            stale_pending.append((i, p))

    if stale_pending:
        print(f"[resolve] TheSportsDB couldn't resolve {len(stale_pending)} pick(s) >=24h old — trying Claude brain")
        claude_results = claude_resolve_stale(stale_pending)
        for idx, out in claude_results.items():
            p = picks[idx]
            p["result"] = out["result"]
            p["resolved_at"] = datetime.now(timezone.utc).isoformat()
            p["resolved_by"] = "claude_brain"
            if out.get("note"):
                p["resolve_note"] = out["note"]
            p["pnl"] = calc_pnl(daily_stake, p.get("odds", "-110"), out["result"])
            resolved.append(p)

    save_picks(picks)
    update_capper_intel(picks)

    total_pnl = sum(p.get("pnl", 0) for p in resolved)
    bankroll["balance"] = round(bankroll["balance"] + total_pnl, 2)
    save_oracle_bankroll(bankroll)

    resolved_output = []
    picks_list = picks.get("picks", []) if isinstance(picks, dict) else picks
    for p in picks_list:
        pnl = p.get("pnl", 0)
        resolved_output.append({**p, "stake": daily_stake, "pnl": pnl})
    # Load existing resolved data
    existing_picks = []
    try:
        with open(RESOLVED_PATH, "r") as f:
            existing_data = json.load(f)
            existing_picks = existing_data.get("picks", [])
    except (FileNotFoundError, json.JSONDecodeError):
        existing_picks = []
    # Append new resolved picks
    existing_picks.extend(resolved_output)
    with open(RESOLVED_PATH, "w") as f:
        json.dump(
            {
                "date": picks.get("date") if isinstance(picks, dict) else None,
                "picks": existing_picks,
                "bankroll": bankroll["balance"],
                "daily_stake": daily_stake,
                "updated": datetime.now(timezone.utc).isoformat(),
            },
            f,
            indent=2,
        )

    if resolved:
        lines = ["<b>Resolved Picks</b>"]
        for p in resolved:
            lines.append(f"✅ {p.get('capper','?')}: {p.get('pick')} ({p.get('sport')}) — {p.get('result')}")
        send_alert("\n".join(lines))

    print(json.dumps({"resolved": len(resolved)}, indent=2))


if __name__ == "__main__":
    main()
