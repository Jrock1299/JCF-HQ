#!/usr/bin/env python3
"""
flashscore_resolver.py — Auto-resolve Oracle's pending picks using Odds API scores.

Note on naming: FlashScore requires a headless browser (Selenium) which is brittle
and slow on VPS. The Odds API already provides a /scores/ endpoint — we have the key,
it's free-tier eligible, reliable, and returns completed game results.
This script uses that.

Runs every 2 hours via cron. Matches pending picks by team name + date, resolves
win/loss/push, updates bankroll, and posts to Agent Hub.
"""

import os, sys, json, requests
from datetime import datetime, timezone, timedelta
from difflib import SequenceMatcher

sys.path.insert(0, '/root/.openclaw/scripts')
from hub_post import add_hub_message as hub_post
from odds_api_keys import make_odds_request, refresh_quotas, quota_status, BASE_URL

# ─── Config ────────────────────────────────────────────────────────────────────
ORACLE_RECORD_PATH  = '/root/.openclaw/agents/oracle/bot/oracle_record.json'
ORACLE_PICKS_PATH   = '/root/.openclaw/dashboard/oracle_picks.json'
ORACLE_RESOLVED_PATH = '/root/.openclaw/dashboard/oracle_resolved.json'
BANKROLL_PATH       = '/root/.openclaw/dashboard/oracle_bankroll.json'

SPORTS = [
    'basketball_nba', 'americanfootball_nfl', 'baseball_mlb',
    'icehockey_nhl', 'basketball_ncaab',
]
SPORT_LABELS = {
    'basketball_nba': 'NBA', 'americanfootball_nfl': 'NFL',
    'baseball_mlb': 'MLB', 'icehockey_nhl': 'NHL', 'basketball_ncaab': 'NCAAB',
}
# Reverse map for resolving
LABEL_TO_KEY = {v: k for k, v in SPORT_LABELS.items()}


def load_env():
    try:
        with open('/etc/environment') as f:
            for line in f:
                line = line.strip()
                if '=' in line and not line.startswith('#'):
                    k, v = line.split('=', 1)
                    os.environ[k.strip()] = v.strip().strip('"').strip("'")
    except Exception:
        pass


load_env()


# ─── Odds API Scores ────────────────────────────────────────────────────────────
def get_scores(sport, days_from=3):
    """
    Fetch completed game scores from Odds API.
    daysFrom=3 returns games completed in the last 3 days.
    """
    url = f'{BASE_URL}/sports/{sport}/scores/'
    data, _ = make_odds_request(url, {'daysFrom': days_from, 'dateFormat': 'iso'})
    if data is not None:
        return data
    print(f'[scores] {sport}: no data (both keys may be exhausted)')
    return []


# ─── Team name matching ─────────────────────────────────────────────────────────
def name_sim(a, b):
    """Fuzzy team name similarity 0.0–1.0."""
    a, b = a.lower().strip(), b.lower().strip()
    if a == b:
        return 1.0
    # Exact last-word match (e.g. "Lakers" vs "Los Angeles Lakers")
    a_last = a.split()[-1] if a.split() else a
    b_last = b.split()[-1] if b.split() else b
    if a_last == b_last:
        return 0.92
    return SequenceMatcher(None, a, b).ratio()


def best_team_sim(pick_name, game):
    """Returns (similarity, team_name) for best matching team in the game."""
    candidates = [game.get('home_team', ''), game.get('away_team', '')]
    best_sim, best_team = 0.0, ''
    for team in candidates:
        s = name_sim(pick_name, team)
        if s > best_sim:
            best_sim, best_team = s, team
    return best_sim, best_team


# ─── Game result ────────────────────────────────────────────────────────────────
def get_winner(game):
    """
    Return the winning team name from a completed game.
    Returns 'PUSH' on tie, None if scores unavailable.
    """
    scores = game.get('scores') or []
    if len(scores) < 2:
        return None
    try:
        s = [(entry['name'], float(entry['score'])) for entry in scores]
    except (KeyError, ValueError, TypeError):
        return None
    if s[0][1] == s[1][1]:
        return 'PUSH'
    return s[0][0] if s[0][1] > s[1][1] else s[1][0]


# ─── P&L calculation ────────────────────────────────────────────────────────────
def calc_pnl(result, odds_str, stake):
    try:
        o = int(str(odds_str).replace('+', '').strip())
        stake = float(stake or 10)
    except Exception:
        return 0.0
    if result == 'push':
        return 0.0
    if result == 'win':
        return round((stake * o / 100) if o > 0 else (stake / (abs(o) / 100)), 2)
    if result == 'loss':
        return -round(stake, 2)
    return 0.0


# ─── Record I/O ─────────────────────────────────────────────────────────────────
def load_record():
    try:
        with open(ORACLE_RECORD_PATH) as f:
            return json.load(f)
    except Exception:
        return {'picks': [], 'version': 1}


def save_record(data):
    with open(ORACLE_RECORD_PATH, 'w') as f:
        json.dump(data, f, indent=2)


def load_bankroll():
    try:
        with open(BANKROLL_PATH) as f:
            d = json.load(f)
            return d.get('balance', 500.0), d.get('starting', 500.0)
    except Exception:
        return 500.0, 500.0


def save_bankroll(balance, starting):
    with open(BANKROLL_PATH, 'w') as f:
        json.dump({
            'bankroll': starting,
            'balance': round(balance, 2),
            'starting': starting,
        }, f, indent=2)


# ─── Dashboard sync ─────────────────────────────────────────────────────────────
def rebuild_oracle_picks_json(rec, balance, starting):
    """
    Rebuild oracle_picks.json cleanly from oracle_record.json.
    Deduplicates by pick ID, most recent 60 picks.
    """
    all_picks = rec.get('picks', [])
    resolved = [p for p in all_picks if p['result'] in ('win', 'loss', 'push')]
    pending  = [p for p in all_picks if p['result'] == 'pending']

    wins   = sum(1 for p in resolved if p['result'] == 'win')
    losses = sum(1 for p in resolved if p['result'] == 'loss')
    total  = wins + losses
    total_pnl = sum((p.get('pnl') or 0) for p in resolved)
    win_rate = f"{round(wins/total*100,1) if total else 0}%"

    # Sort by game date desc, cap at 60
    sorted_picks = sorted(
        resolved + pending,
        key=lambda x: x.get('commence', ''),
        reverse=True,
    )[:60]

    display = []
    for p in sorted_picks:
        display.append({
            'id':     p.get('id', ''),
            'pick':   f"{p['pick']} ({p['odds_at_log']})",
            'odds':   p['odds_at_log'],
            'league': p.get('sport', ''),
            'stake':  p.get('stake', 10),
            'date':   p.get('commence', ''),
            'result': p['result'],
            'pnl':    p.get('pnl') or 0,
        })

    payload = {
        'bankroll':     starting,
        'balance':      round(balance, 2),
        'record':       f'{wins}W \u2013 {losses}L',
        'win_rate':     win_rate,
        'total_pnl':    round(total_pnl, 2),
        'last_updated': datetime.now(timezone.utc).isoformat(),
        'picks':        display,
    }
    with open(ORACLE_PICKS_PATH, 'w') as f:
        json.dump(payload, f, indent=2)


def rebuild_oracle_resolved_json(rec):
    resolved = [p for p in rec.get('picks', []) if p['result'] in ('win', 'loss', 'push')]
    with open(ORACLE_RESOLVED_PATH, 'w') as f:
        json.dump({'date': datetime.now(timezone.utc).isoformat(), 'picks': resolved}, f, indent=2)


# ─── Main resolution loop ───────────────────────────────────────────────────────
def run():
    print(f'[resolver] {datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")} — starting')

    # Refresh quota counts from API headers (free call, catches monthly resets)
    refresh_quotas()
    print(f'[quota] {quota_status()}')

    # Load all completed games (last 3 days) grouped by sport key
    all_games: dict[str, list] = {}
    for sport in SPORTS:
        games = get_scores(sport, days_from=3)
        completed = [g for g in games if g.get('completed')]
        all_games[sport] = completed
        print(f'[resolver] {SPORT_LABELS[sport]}: {len(completed)} completed games found')

    rec = load_record()
    pending = [p for p in rec['picks'] if p['result'] == 'pending']

    if not pending:
        print('[resolver] No pending picks — nothing to resolve.')
        return

    print(f'[resolver] {len(pending)} pending pick(s) to check')

    balance, starting = load_bankroll()
    resolved_count = 0
    resolution_log = []

    for pick in rec['picks']:
        if pick['result'] != 'pending':
            continue

        # Determine which sport bucket to search
        sport_key = LABEL_TO_KEY.get(pick.get('sport', ''), '')
        candidate_games = all_games.get(sport_key, [])
        if not candidate_games:
            # Fall back to searching all sports
            candidate_games = [g for gs in all_games.values() for g in gs]

        # Parse pick commence time
        try:
            pick_dt = datetime.fromisoformat(
                pick.get('commence', '').replace('Z', '+00:00')
            ).astimezone(timezone.utc)
        except Exception:
            continue

        # Find best matching game (within 18 hours, similarity ≥ 0.60)
        best_game, best_sim = None, 0.0
        for game in candidate_games:
            try:
                game_dt = datetime.fromisoformat(
                    game.get('commence_time', '').replace('Z', '+00:00')
                ).astimezone(timezone.utc)
                if abs((pick_dt - game_dt).total_seconds()) > 64800:  # 18 hours
                    continue
            except Exception:
                continue

            sim, _ = best_team_sim(pick['pick'], game)
            if sim > best_sim:
                best_sim, best_game = sim, game

        if best_game is None or best_sim < 0.60:
            continue  # Game not yet complete or no match

        winner = get_winner(best_game)
        if winner is None:
            continue

        # Resolve
        if winner == 'PUSH':
            result = 'push'
        else:
            pick_sim, _ = best_team_sim(pick['pick'], {'home_team': winner, 'away_team': winner})
            # Direct compare: did we pick the winning team?
            actual_sim = name_sim(pick['pick'], winner)
            result = 'win' if actual_sim >= 0.60 else 'loss'

        pnl = calc_pnl(result, pick['odds_at_log'], pick.get('stake', 10))

        pick['result']      = result
        pick['pnl']         = pnl
        pick['resolved_at'] = datetime.now(timezone.utc).isoformat()
        pick['game_result'] = {
            'home':   best_game.get('home_team'),
            'away':   best_game.get('away_team'),
            'winner': winner,
            'sim':    round(best_sim, 3),
        }

        balance += pnl
        resolved_count += 1
        icon = '✅' if result == 'win' else ('❌' if result == 'loss' else '➡️')
        line = f"{icon} {pick['pick']} ({pick['odds_at_log']}) {'+' if pnl >= 0 else ''}{pnl:.2f}"
        resolution_log.append(line)
        print(f'[resolver] {result.upper():5s} {pick["pick"]:35s} {pnl:+.2f}')

    if resolved_count == 0:
        print('[resolver] No picks resolved this run.')
        return

    save_record(rec)
    save_bankroll(balance, starting)
    rebuild_oracle_picks_json(rec, balance, starting)
    rebuild_oracle_resolved_json(rec)

    summary = f"🔮 Oracle resolved {resolved_count} pick(s):\n" + '\n'.join(resolution_log)
    summary += f"\nNew balance: ${balance:.2f}"
    hub_post("oracle", "status", summary, tags=["betting", "resolution"])
    print(f'[resolver] Done. {resolved_count} resolved. Balance: ${balance:.2f}')


if __name__ == '__main__':
    run()
