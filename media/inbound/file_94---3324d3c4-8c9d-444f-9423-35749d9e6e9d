/* ============================================================
   MORNING REPORT
   ============================================================ */
function toggleMorningReport(){
  const body=document.getElementById('morningReportBody');
  const chevron=document.getElementById('morningReportChevron');
  const open=body.style.display==='none';
  body.style.display=open?'block':'none';
  chevron.style.transform=open?'rotate(180deg)':'rotate(0deg)';
  if(open) loadMorningReport();
}
async function loadMorningReport(){
  const content=document.getElementById('morningReportContent');
  const meta=document.getElementById('morningReportMeta');
  const dateEl=document.getElementById('morningReportDate');
  try{
    const r=await fetch('morning_report.json?t='+Date.now());
    if(!r.ok) throw new Error('No report');
    const report=await r.json();
    content.textContent=report.text||'No content';
    meta.textContent=report.summary||'Latest report';
    dateEl.textContent=report.date||'';
  } catch(e){
    content.textContent='No morning report yet.\n\nHuncho will auto-populate this at 9AM daily with:\n• Trading results (Crisp + Blade)\n• Oracle sports picks + results\n• Workflow improvement idea\n• Market overview';
    meta.textContent='No report yet — auto-updates at 9AM daily';
    dateEl.textContent='';
  }
}

function updateClock(){
  const now=new Date(),h=now.getHours();
  document.getElementById('timeOfDay').textContent=h<12?'morning':h<17?'afternoon':'evening';
  document.getElementById('liveDate').textContent=now.toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'})+' · '+now.toLocaleTimeString();
  const daysLeft=Math.ceil((new Date('2037-01-01')-now)/86400000);
  document.getElementById('daysLeft').textContent=daysLeft.toLocaleString();
}
setInterval(updateClock,1000);updateClock();

/* ============================================================
   NET WORTH
   ============================================================ */
function updateNetWorth(){
  const d=S.get('networth')||{current:0,goal:10000000};
  const pct=Math.min(100,(d.current/d.goal)*100);
  const fmt=n=>n>=1000000?'$'+(n/1e6).toFixed(2)+'M':n>=1000?'$'+(n/1000).toFixed(1)+'K':'$'+n;
  document.getElementById('nwPct').textContent=pct.toFixed(1)+'%';
  document.getElementById('nwBar').style.width=pct+'%';
  document.getElementById('netWorthDisplay').textContent=fmt(d.current)+' / '+fmt(d.goal);
}
function openNetWorthModal(){
  const d=S.get('networth')||{current:0,goal:10000000};
  showModal(`<div class="modal-title">💎 Net Worth Tracker</div>
    <div class="form-group mb-4"><label class="form-label">Current Net Worth ($)</label><input class="form-input" id="m_nwCurrent" value="${d.current}" type="number" style="width:100%"></div>
    <div class="form-group"><label class="form-label">Goal ($)</label><input class="form-input" id="m_nwGoal" value="${d.goal}" type="number" style="width:100%"></div>
    <div class="modal-actions"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveNetWorth()">Save</button></div>`);
}
function saveNetWorth(){
  S.set('networth',{current:parseFloat(document.getElementById('m_nwCurrent').value)||0,goal:parseFloat(document.getElementById('m_nwGoal').value)||10000000});
  updateNetWorth();closeModal();
}

/* ============================================================
   ACTIVITY FEED
   ============================================================ */
function renderActivityFeed(){
  const items=S.get('activity')||[
    {text:'JCF HQ v2 — Mission Control online',time:new Date().toISOString(),color:'blue'},
    {text:'Crisp & Blade paper trading sessions configured',time:new Date().toISOString(),color:'gold'},
    {text:'Oracle intelligence system activated',time:new Date().toISOString(),color:'green'},
  ];
  document.getElementById('activityFeed').innerHTML=items.slice(-20).reverse().map(i=>`
    <div class="activity-item"><div class="activity-dot ${i.color||'blue'}"></div><div class="activity-text">${i.text}</div><div class="activity-time">${timeAgo(i.time)}</div></div>`).join('');
}
function addActivity(text){
  if(!text){const t=prompt('New activity:');if(!t)return;text=t;}
  const items=S.get('activity')||[];
  items.push({text,time:new Date().toISOString(),color:'blue'});
  S.set('activity',items);renderActivityFeed();
}
function timeAgo(iso){
  const d=Date.now()-new Date(iso);
  if(d<60000)return'just now';if(d<3600000)return Math.floor(d/60000)+'m ago';
  if(d<86400000)return Math.floor(d/3600000)+'h ago';return Math.floor(d/86400000)+'d ago';
}

