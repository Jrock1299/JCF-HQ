function saveEditTrade(id){
  const d=getPortData();
  const idx=d.trades.findIndex(t=>t.id===id);
  if(idx<0)return;
  d.trades[idx]={...d.trades[idx],account:document.getElementById('m_trAcc').value,date:document.getElementById('m_trDate').value,asset:document.getElementById('m_trAsset').value,direction:document.getElementById('m_trDir').value,entry:parseFloat(document.getElementById('m_trEntry').value)||null,exit:parseFloat(document.getElementById('m_trExit').value)||null,pnl:parseFloat(document.getElementById('m_trPnl').value)||0,status:document.getElementById('m_trStatus').value,notes:document.getElementById('m_trNotes').value};
  savePortData(d);renderPortfolio();closeModal();
}

function deleteTrade(id){
  if(!confirm('Delete this trade?'))return;
  const d=getPortData();
  d.trades=d.trades.filter(t=>t.id!==id);
  savePortData(d);renderPortfolio();closeModal();
}

