   ============================================================ */
const PORT_ACCOUNTS = [
  { id:'robinhood', label:'Robinhood', icon:'📈', cls:'robinhood', sub:'Stocks + Options + Roth IRA', fields:['stocks','options','roth_ira'] },
  { id:'tradelocker', label:'TradeLocker', icon:'⚡', cls:'tradelocker', sub:'Manual Trades', fields:['balance'] },
  { id:'crypto', label:'Trust Wallet', icon:'🪙', cls:'crypto', sub:'Crypto Holdings', fields:['balance'] },
  { id:'cash', label:'HYSA', icon:'🏦', cls:'cash', sub:'High Yield Savings', fields:['balance'] },
  { id:'insurance', label:'Northwestern Mutual', icon:'🛡️', cls:'insurance', sub:'Life Insurance Cash Value', fields:['cash_value'] },
];

function getPortData() { return S.get('portfolio') || { accounts:{}, trades:[] }; }
function savePortData(d) { S.set('portfolio', d); }

function calcTotal(d) {
  const accs = d.accounts || {};
  let total = 0;
  total += (accs.robinhood?.stocks||0) + (accs.robinhood?.options||0) + (accs.robinhood?.roth_ira||0);
  total += (accs.tradelocker?.balance||0);
  total += (accs.crypto?.balance||0);
  total += (accs.cash?.balance||0);
  total += (accs.insurance?.cash_value||0);
  return total;
}

function fmtMoney(n, short=false) {
  if(short) { if(Math.abs(n)>=1000000) return '$'+(n/1e6).toFixed(2)+'M'; if(Math.abs(n)>=1000) return '$'+(n/1000).toFixed(1)+'K'; }
  return (n<0?'-$':'$')+Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
}

function renderPortfolio() {
  const d = getPortData();
  const total = calcTotal(d);
  document.getElementById('portTotalNW').textContent = fmtMoney(total, true);
  document.getElementById('portLastUpdate').textContent = d.lastUpdate ? new Date(d.lastUpdate).toLocaleDateString() : 'Not set';

  // Today P&L from trades
  const today = new Date().toISOString().split('T')[0];
  const trades = d.trades || [];
  const todayPnl = trades.filter(t=>t.date===today&&t.pnl).reduce((s,t)=>s+(t.pnl||0),0);
  const ytdPnl = trades.filter(t=>t.date&&t.date.startsWith(new Date().getFullYear().toString())&&t.pnl).reduce((s,t)=>s+(t.pnl||0),0);
  const todayEl = document.getElementById('portTodayPnl');
  const ytdEl = document.getElementById('portYtdPnl');
  todayEl.textContent = fmtMoney(todayPnl);
  todayEl.style.color = todayPnl>=0?'var(--green)':todayPnl<0?'var(--red)':'var(--text)';
  ytdEl.textContent = fmtMoney(ytdPnl);
  ytdEl.style.color = ytdPnl>=0?'var(--green)':ytdPnl<0?'var(--red)':'var(--text)';

  // Build card HTML for each account
  const accCards = PORT_ACCOUNTS.map((a, idx) => {
    const acc = (d.accounts||{})[a.id] || {};
    let balance = 0, subLines = [];
    if(a.id==='robinhood') {
      balance = (acc.stocks||0)+(acc.options||0)+(acc.roth_ira||0);
      subLines = [`Stocks: ${fmtMoney(acc.stocks||0,true)}`,`Options: ${fmtMoney(acc.options||0,true)}`,`Roth IRA: ${fmtMoney(acc.roth_ira||0,true)}`];
    } else if(a.id==='insurance') {
      balance = acc.cash_value||0;
    } else {
      balance = acc.balance||0;
    }
    const pct = total>0?(balance/total*100).toFixed(1):0;
    const color = a.id==='robinhood'?'#00c805':a.id==='crypto'?'#f7931a':a.id==='cash'?'var(--green)':a.id==='insurance'?'var(--purple)':'var(--blue)';
    return {
      desktop: `<div class="port-account-card ${a.cls}" onclick="openPortEditModal()">
        <div class="port-account-icon">${a.icon}</div>
        <div class="port-account-label">${a.label}</div>
        <div class="port-account-balance" style="color:${color}">${fmtMoney(balance,true)}</div>
        <div class="port-account-sub">${a.sub}</div>
        ${subLines.map(l=>`<div style="font-size:10px;color:var(--text3);margin-top:2px">${l}</div>`).join('')}
        <div style="margin-top:10px;font-size:10px;color:var(--text2)">${pct}% of portfolio</div>
        <div style="margin-top:6px;background:var(--surface2);border-radius:3px;height:3px"><div style="height:100%;border-radius:3px;background:${color};width:${pct}%"></div></div>
      </div>`,
      mobile: `<div class="port-account-card ${a.cls}" style="min-width:100%;box-sizing:border-box" onclick="openPortEditModal()">
        <div class="port-account-icon">${a.icon}</div>
        <div class="port-account-label">${a.label}</div>
        <div class="port-account-balance" style="color:${color}">${fmtMoney(balance,true)}</div>
        <div class="port-account-sub">${a.sub}</div>
        ${subLines.map(l=>`<div style="font-size:11px;color:var(--text3);margin-top:3px">${l}</div>`).join('')}
        <div style="margin-top:12px;font-size:11px;color:var(--text2)">${pct}% of portfolio</div>
        <div style="margin-top:6px;background:var(--surface2);border-radius:3px;height:4px"><div style="height:100%;border-radius:3px;background:${color};width:${pct}%"></div></div>
      </div>`
    };
  });

  // Desktop grid
  const desktopEl = document.getElementById('portAccountsDesktop');
  if(desktopEl) desktopEl.innerHTML = accCards.map(c=>c.desktop).join('');

  // Mobile carousel
  const mobileEl = document.getElementById('portAccountsGrid');
  if(mobileEl) mobileEl.innerHTML = accCards.map(c=>c.mobile).join('');
  const dotsEl = document.getElementById('portDots');
  if(dotsEl) dotsEl.innerHTML = PORT_ACCOUNTS.map((_,i)=>`<div style="width:7px;height:7px;border-radius:50%;background:${i===portAccIdx?'var(--blue)':'var(--surface2)'};transition:background .2s;cursor:pointer" onclick="goToAccount(${i})"></div>`).join('');
  goToAccount(portAccIdx);

  // Year + month selector
  const yr = new Date().getFullYear();
  const yrSel = document.getElementById('calYearSelect');
  if(yrSel && !yrSel.options.length) {
    for(let y=yr;y>=yr-2;y--) { const o=document.createElement('option'); o.value=y; o.textContent=y; yrSel.appendChild(o); }
  }
  // Default month to current
  const mSel = document.getElementById('calMonthSelect');
  if(mSel && mSel.value === '0' && new Date().getMonth() !== 0) {
    mSel.value = new Date().getMonth().toString();
  }

  renderAllCalendars();
  renderTradeLog();

  // Sync net worth to dashboard
  const nwData = S.get('networth')||{current:0,goal:10000000};
  nwData.current = total;
  S.set('networth', nwData);
  updateNetWorth();
}

