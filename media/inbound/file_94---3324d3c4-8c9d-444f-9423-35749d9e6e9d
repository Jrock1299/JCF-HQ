</div>

<!-- ===== TIMELINE ===== -->
<div id="tab-timeline" class="tab-content">
  <div class="section-title mb-5">🗺️ Road to Dream Life — 2025–2037</div>
  <div class="timeline" id="timelineContainer"></div>
</div>

<!-- ===== REVENUE ===== -->
<div id="tab-revenue" class="tab-content">
