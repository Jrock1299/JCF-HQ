    <div class="kanban-col">
      <div class="kanban-col-header"><span class="kanban-col-title" style="color:var(--green)">✅ Done</span><span class="kanban-count" id="count-done">0</span></div>
      <div id="tasks-done"></div>
      <button class="add-btn" onclick="openTaskModal('done')">+ Add Task</button>
