async function syncOracleResolved(){
  try{
    const r=await fetch('oracle_resolved.json?t='+Date.now());
    if(!r.ok)return;
    const data=await r.json();
    const resolved=data.picks||[];
    if(!resolved.length)return;
    const d=getBettingData();
    d.oracle_picks_history=d.oracle_picks_history||[];
    resolved.forEach(p=>{
      const idx=d.oracle_picks_history.findIndex(h=>h.pick===p.pick&&h.date===p.date);
      if(idx>=0){
        d.oracle_picks_history[idx].result=p.result||d.oracle_picks_history[idx].result;
        d.oracle_picks_history[idx].pnl=p.pnl||d.oracle_picks_history[idx].pnl;
      }
    });
    saveBettingData(d);renderBetting();
  }catch(e){console.error('syncOracleResolved:',e);}
}



function renderBetting(){
  const d=getBettingData();
  const el=id=>document.getElementById(id);
  // Your bankroll
  const bets=d.bets||[];
  const wins=bets.filter(b=>b.result==='W').length;
  // Fetch Oracle bankroll from server
  fetch('oracle_bankroll.json?t='+Date.now()).then(r=>r.json()).then(bk=>{
    const oStarting=bk.starting||500;
    const oCurrent=bk.balance||500;
    const oPnl=oCurrent-oStarting;
    const oRoi=oStarting>0?((oPnl/oStarting)*100).toFixed(1):0;
    el('obkStarting').textContent=fmtMoney(oStarting,true);
    el('obkCurrent').textContent=fmtMoney(oCurrent,true);
    el('obkCurrent').style.color=oCurrent>=oStarting?'var(--blue)':'var(--red)';
    el('obkROI').textContent=`ROI: ${oRoi}%`;
    el('obkPnl').textContent=fmtMoney(oPnl,true);
    el('obkPnl').style.color=oPnl>=0?'var(--green)':'var(--red)';
  }).catch(()=>{
    el('obkStarting').textContent='$500';
    el('obkCurrent').textContent='$500';
    el('obkROI').textContent='ROI: 0%';
    el('obkPnl').textContent='$0';
  });
  const losses=bets.filter(b=>b.result==='L').length;
  const pushes=bets.filter(b=>b.result==='P').length;
  const totalPnl=bets.reduce((s,b)=>s+(b.pnl||0),0);
  const current=(d.starting||0)+totalPnl;
  const roi=d.starting>0?((totalPnl/d.starting)*100).toFixed(1):0;
  el('bkStarting').textContent=fmtMoney(d.starting||0,true);
  el('bkCurrent').textContent=fmtMoney(current,true);
  el('bkCurrent').style.color=current>=(d.starting||0)?'var(--blue)':'var(--red)';
  el('bkROI').textContent=`ROI: ${roi}%`;
  el('bkPnl').textContent=fmtMoney(totalPnl,true);
  el('bkPnl').style.color=totalPnl>=0?'var(--green)':'var(--red)';
  el('bkRecord').textContent=`W:${wins} L:${losses} P:${pushes}`;
  // Oracle pick history
  const oph=d.oracle_picks_history||[];
  const owins=oph.filter(p=>p.result==='W').length;
  const olosses=oph.filter(p=>p.result==='L').length;
