      <button class="btn btn-gold" onclick="openRevenueGoalModal()">Set Goal</button>
    </div>
  </div>

  <!-- PERSONAL INCOME SUMMARY -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap);margin-bottom:28px">
    <div class="glass-card" style="border-top:3px solid var(--gold)">
      <div style="font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px">This Month</div>
      <div style="font-family:'Syne',sans-serif;font-size:28px;font-weight:800;color:var(--gold)" id="incomeThisMonth">$0</div>
      <div style="font-size:11px;color:var(--text2);margin-top:6px" id="incomeMonthLabel">—</div>
    </div>
    <div class="glass-card" style="border-top:3px solid var(--green)">
      <div style="font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px">YTD Income</div>
      <div style="font-family:'Syne',sans-serif;font-size:28px;font-weight:800;color:var(--green)" id="incomeYTD">$0</div>
      <div style="font-size:11px;color:var(--text2);margin-top:6px" id="incomeYTDLabel">Jan – now</div>
    </div>
    <div class="glass-card" style="border-top:3px solid var(--blue)">
      <div style="font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px">Monthly Avg</div>
      <div style="font-family:'Syne',sans-serif;font-size:28px;font-weight:800;color:var(--blue)" id="incomeAvg">$0</div>
      <div style="font-size:11px;color:var(--text2);margin-top:6px">Per active month</div>
    </div>
  </div>

  <!-- MONTHLY BREAKDOWN + GOAL GAUGE -->
  <div class="revenue-grid mb-5">
    <div class="glass-card" style="display:flex;flex-direction:column;align-items:center;justify-content:center">
      <div class="card-label">Monthly Revenue Goal</div>
      <div style="position:relative;display:inline-block">
        <svg width="160" height="160" id="gaugeSvg">
          <circle cx="80" cy="80" r="62" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="10"/>
          <circle cx="80" cy="80" r="62" fill="none" stroke="url(#gaugeGrad)" stroke-width="10" stroke-linecap="round" stroke-dasharray="390" id="gaugeArc" stroke-dashoffset="390" transform="rotate(-90 80 80)"/>
          <defs><linearGradient id="gaugeGrad" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#00d4ff"/><stop offset="100%" stop-color="#ffd166"/></linearGradient></defs>
        </svg>
        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center">
          <div style="font-family:'Syne',sans-serif;font-size:26px;font-weight:800;color:var(--gold)" id="gaugePct">0%</div>
          <div style="font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.08em">of goal</div>
        </div>
      </div>
      <div style="text-align:center;margin-top:10px">
        <div style="font-family:'DM Mono',monospace;font-size:12px;color:var(--text2)">MRR: <span id="mrrDisplay" style="color:var(--gold)">$0</span></div>
        <div style="font-family:'DM Mono',monospace;font-size:12px;color:var(--text2)">Goal: <span id="goalDisplay" style="color:var(--green)">$0</span></div>
      </div>
    </div>
    <div class="glass-card">
      <div class="card-label">Monthly Income History</div>
      <div class="chart-bars" id="revChart"></div>
    </div>
  </div>

  <!-- AGENT P&L TRACKER (Crisp + Blade only) -->
  <div class="section-title mb-4">🤖 Agent P&L Tracker</div>
  <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:var(--gap);margin-bottom:28px">
    <div class="agent-pnl-card crisp">
      <div class="agent-pnl-name">⚡ Crisp</div>
      <div class="agent-pnl-role">Crypto ORB — Binance Paper</div>
      <div class="agent-pnl-val pos" id="crispPnl">+$0.00</div>
      <div class="agent-pnl-stats">
        <div class="agent-pnl-stat"><div class="agent-pnl-stat-label">Trades</div><div class="agent-pnl-stat-val" id="crispTrades">0</div></div>
        <div class="agent-pnl-stat"><div class="agent-pnl-stat-label">Win Rate</div><div class="agent-pnl-stat-val" id="crispWR">0%</div></div>
        <div class="agent-pnl-stat"><div class="agent-pnl-stat-label">Best Trade</div><div class="agent-pnl-stat-val" id="crispBest">$0</div></div>
        <div class="agent-pnl-stat"><div class="agent-pnl-stat-label">Sessions</div><div class="agent-pnl-stat-val" id="crispSessions">0</div></div>
      </div>
    </div>
    <div class="agent-pnl-card blade">
