function renderAllCalendars() {
  const d = getPortData();
  const trades = d.trades || [];
  const yr = parseInt(document.getElementById('calYearSelect')?.value || new Date().getFullYear());
  const m = parseInt(document.getElementById('calMonthSelect')?.value ?? new Date().getMonth());
  const accFilter = document.getElementById('calAccountSelect')?.value || 'all';
  const filtered = accFilter==='all' ? trades : trades.filter(t=>t.account===accFilter);

  const dayMap = {};
  filtered.forEach(t => {
    if(!t.date||t.pnl==null) return;
    dayMap[t.date] = (dayMap[t.date]||0) + t.pnl;
  });

  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const today = new Date().toISOString().split('T')[0];

  const firstDay = new Date(yr, m, 1).getDay();
  const daysInMonth = new Date(yr, m+1, 0).getDate();
  let monthProfit=0, monthLoss=0, tradeDays=0;

  let daysHtml = '';
  for(let i=0;i<firstDay;i++) daysHtml += '<div class="cal-day empty"></div>';
  for(let day=1;day<=daysInMonth;day++) {
    const dateStr = `${yr}-${String(m+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
    const pnl = dayMap[dateStr];
    let cls = 'no-trade';
    if(pnl !== undefined) {
      tradeDays++;
      if(pnl>0){cls='profit';monthProfit+=pnl;}
      else if(pnl<0){cls='loss';monthLoss+=pnl;}
      else cls='breakeven';
    }
    const isToday = dateStr===today?' today':'';
    const tooltip = pnl!==undefined?` title="${dateStr}: ${fmtMoney(pnl)}"`:` title="${dateStr}"`;
    daysHtml += `<div class="cal-day ${cls}${isToday}"${tooltip} onclick="showDayTrades('${dateStr}')" style="font-size:12px;padding:6px">${day}</div>`;
  }

  const netMonth = monthProfit+monthLoss;
  const section = document.getElementById('calendarSection');
  if(section) section.innerHTML = `
    <div class="cal-wrap">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
        <div style="font-family:'Syne',sans-serif;font-size:16px;font-weight:700">${MONTHS[m]} ${yr}</div>
        <div style="display:flex;gap:8px">
          <button onclick="prevMonth()" style="background:var(--surface2);border:1px solid var(--border);border-radius:7px;padding:5px 12px;color:var(--text);cursor:pointer;font-size:14px">‹ Prev</button>
          <button onclick="nextMonth()" style="background:var(--surface2);border:1px solid var(--border);border-radius:7px;padding:5px 12px;color:var(--text);cursor:pointer;font-size:14px">Next ›</button>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:6px">
        ${DAYS.map(d=>`<div style="font-size:10px;color:var(--text3);text-align:center;font-weight:600;padding:4px">${d}</div>`).join('')}
      </div>
      <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px">${daysHtml}</div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding-top:14px;border-top:1px solid var(--border)">
        <div style="text-align:center">
          <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px">Profit Days</div>
          <div style="font-family:'DM Mono',monospace;font-size:14px;color:var(--green)">${fmtMoney(monthProfit,true)}</div>
        </div>
        <div style="text-align:center">
          <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px">Trade Days</div>
          <div style="font-family:'DM Mono',monospace;font-size:14px;color:var(--text)">${tradeDays}</div>
        </div>
        <div style="text-align:center">
          <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px">Net P&L</div>
          <div style="font-family:'DM Mono',monospace;font-size:16px;font-weight:700;color:${netMonth>=0?'var(--green)':'var(--red)'}">${fmtMoney(netMonth,true)}</div>
        </div>
        <div style="text-align:center">
          <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px">Loss Days</div>
          <div style="font-family:'DM Mono',monospace;font-size:14px;color:var(--red)">${fmtMoney(monthLoss,true)}</div>
        </div>
      </div>
    </div>`;
}

function prevMonth() {
  const mSel = document.getElementById('calMonthSelect');
  const yrSel = document.getElementById('calYearSelect');
  let m = parseInt(mSel.value);
  let y = parseInt(yrSel.value);
  if(m===0){m=11;y--;}else m--;
  mSel.value=m;yrSel.value=y;
  renderAllCalendars();
}
function nextMonth() {
  const mSel = document.getElementById('calMonthSelect');
  const yrSel = document.getElementById('calYearSelect');
  let m = parseInt(mSel.value);
  let y = parseInt(yrSel.value);
  if(m===11){m=0;y++;}else m++;
  mSel.value=m;yrSel.value=y;
  renderAllCalendars();
}

