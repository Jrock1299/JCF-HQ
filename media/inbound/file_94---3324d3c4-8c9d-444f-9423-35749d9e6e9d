/* ============================================================
   REVENUE
   ============================================================ */
function renderRevenue(){
  const data=S.get('revenue')||{goal:10000,months:[],clients:[]};
  const inc=getIncomeData();
  const entries=inc.entries||[];
  const now=new Date();
  const thisMonth=now.toISOString().slice(0,7);
  const lastMonth=new Date(now.getFullYear(),now.getMonth()-1,1).toISOString().slice(0,7);
  const thisMonthTotal=entries.filter(e=>e.date&&e.date.startsWith(thisMonth)).reduce((s,e)=>s+(e.amount||0),0);
  const ytdTotal=entries.filter(e=>e.date&&e.date.startsWith(now.getFullYear().toString())).reduce((s,e)=>s+(e.amount||0),0);
  const activeMonths=Math.max([...new Set(entries.map(e=>e.date&&e.date.slice(0,7)).filter(Boolean))].length,1);
  const avgIncome=ytdTotal/activeMonths;
  const mrr=thisMonthTotal;
  const goal=parseFloat(data.goal)||10000;
  const pct=goal>0?Math.min(100,(mrr/goal)*100):0;
  document.getElementById('gaugePct').textContent=pct.toFixed(0)+'%';
  document.getElementById('gaugeArc').style.strokeDashoffset=390-(390*pct/100);
  document.getElementById('mrrDisplay').textContent='$'+mrr.toLocaleString();
  document.getElementById('goalDisplay').textContent='$'+goal.toLocaleString();
  const el=id=>document.getElementById(id);
  if(el('incomeThisMonth'))el('incomeThisMonth').textContent=fmtMoney(thisMonthTotal,true);
  if(el('incomeMonthLabel'))el('incomeMonthLabel').textContent=now.toLocaleDateString('en-US',{month:'long',year:'numeric'});
  if(el('incomeYTD'))el('incomeYTD').textContent=fmtMoney(ytdTotal,true);
  if(el('incomeAvg'))el('incomeAvg').textContent=fmtMoney(avgIncome,true);
  // Income chart
  const monthMap={};
  entries.forEach(e=>{if(e.date){const m=e.date.slice(0,7);monthMap[m]=(monthMap[m]||0)+(e.amount||0);}});
  const sortedMonths=Object.keys(monthMap).sort().slice(-6);
  const maxVal=Math.max(...sortedMonths.map(m=>monthMap[m]),1);
  const MONTH_LABELS=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  el('revChart').innerHTML=sortedMonths.length?sortedMonths.map((m,i)=>{const mo=parseInt(m.slice(5))-1;const lbl=MONTH_LABELS[mo]||m.slice(5);return`<div class="chart-bar-wrap"><div class="chart-val">${fmtMoney(monthMap[m],true)}</div><div class="chart-bar ${i===sortedMonths.length-1?'gold':''}" style="height:${Math.max(6,(monthMap[m]/maxVal)*120)}px"></div><div class="chart-label">${lbl}</div></div>`;}).join(''):'<div style="color:var(--text3);font-size:12px;padding:20px">No income logged yet</div>';
  // Income log
  const filter=el('incomeMonthFilter')?.value||'all';
  let filtered=[...entries];
  if(filter==='this')filtered=entries.filter(e=>e.date&&e.date.startsWith(thisMonth));
  if(filter==='last')filtered=entries.filter(e=>e.date&&e.date.startsWith(lastMonth));
  filtered=filtered.reverse().slice(0,50);
  if(el('incomeLogBody'))el('incomeLogBody').innerHTML=filtered.length?filtered.map(e=>`<div style="display:grid;grid-template-columns:100px 120px 1fr 100px 90px;gap:8px;padding:11px 16px;border-top:1px solid var(--border);font-size:12px;align-items:center"><span style="font-size:11px;color:var(--text2);font-family:'DM Mono',monospace">${e.date||'—'}</span><span style="font-size:11px;padding:2px 8px;border-radius:4px;background:var(--surface2);color:var(--gold)">${e.category||'—'}</span><span style="font-weight:500">${e.source||'—'}</span><span style="font-family:'DM Mono',monospace;font-weight:700;color:var(--green)">${fmtMoney(e.amount||0,true)}</span><span style="display:flex;gap:4px"><button onclick="editIncome('${e.id}')" style="font-size:10px;padding:3px 6px;border-radius:4px;background:var(--surface2);border:1px solid var(--border);color:var(--text2);cursor:pointer">✏️</button><button onclick="deleteIncome('${e.id}')" style="font-size:10px;padding:3px 6px;border-radius:4px;background:rgba(255,91,91,0.15);border:none;color:var(--red);cursor:pointer">✕</button></span></div>`).join(''):'<div style="padding:20px;color:var(--text3);font-size:12px;text-align:center">No income logged yet</div>';
  // Agent P&L
  const agentStats=S.get('agent_pnl')||{crisp:{pnl:0,trades:0,wr:0,best:0,sessions:0},blade:{pnl:0,trades:0,wr:0,best:0,sessions:0}};
  el('crispPnl').textContent=fmtMoney(agentStats.crisp?.pnl||0);
  el('crispPnl').className='agent-pnl-val '+(agentStats.crisp?.pnl>=0?'pos':'neg');
  el('crispTrades').textContent=agentStats.crisp?.trades||0;
  el('crispWR').textContent=(agentStats.crisp?.wr||0)+'%';
  el('crispBest').textContent=fmtMoney(agentStats.crisp?.best||0,true);
  el('crispSessions').textContent=agentStats.crisp?.sessions||0;
  el('bladePnl').textContent=fmtMoney(agentStats.blade?.pnl||0);
  el('bladePnl').className='agent-pnl-val '+(agentStats.blade?.pnl>=0?'pos':'neg');
  el('bladeTrades').textContent=agentStats.blade?.trades||0;
  el('bladeWR').textContent=(agentStats.blade?.wr||0)+'%';
  el('bladeBest').textContent=fmtMoney(agentStats.blade?.best||0,true);
  el('bladeSessions').textContent=agentStats.blade?.sessions||0;
  el('clientsList').innerHTML=(data.clients||[]).map((c,i)=>`<div class="client-row"><div class="client-name">${c.name}</div><div class="client-mrr">$${c.mrr.toLocaleString()}/mo</div><div class="client-delete" onclick="deleteClient(${i})">✕</div></div>`).join('')||'<div style="color:var(--text3);font-size:12px;padding:12px">No revenue streams added yet</div>';
  const annual=mrr*12;
  el('projAnnual').textContent='$'+annual.toLocaleString();
  el('projGrowth').textContent=mrr>0?'$'+Math.max(0,goal-mrr).toLocaleString()+'/mo needed':'Add revenue';
  if(mrr>0){const d=new Date();d.setMonth(d.getMonth()+Math.ceil((goal*12-annual)/mrr));el('projDate').textContent=d.toLocaleDateString('en-US',{month:'short',year:'numeric'});}
  else el('projDate').textContent='—';
}
