        <span style="font-size:10px;padding:2px 5px;border-radius:4px;white-space:nowrap;background:${b.result==='W'?'rgba(61,220,132,0.15)':b.result==='L'?'rgba(255,91,91,0.15)':b.result==='P'?'rgba(255,209,102,0.15)':'var(--surface2)'};color:${b.result==='W'?'var(--green)':b.result==='L'?'var(--red)':b.result==='P'?'var(--gold)':'var(--text2)'}">${b.result||'Pending'}</span>
        <button onclick="editBet('${b.id}')" style="font-size:10px;padding:3px 5px;border-radius:4px;background:var(--surface2);border:1px solid var(--border);color:var(--text2);cursor:pointer">✏️</button>
        <button onclick="deleteBet('${b.id}')" style="font-size:10px;padding:3px 5px;border-radius:4px;background:rgba(255,91,91,0.15);border:none;color:var(--red);cursor:pointer">✕</button>
      </span>
    </div>`).join(''):'<div style="padding:20px;color:var(--text3);font-size:12px;text-align:center">No bets logged yet</div>';
}

async function refreshOraclePicks(){
  const el=document.getElementById('oracleDailyPicks');
  if(!el)return;
  el.innerHTML='<div style="padding:20px;color:var(--text3);font-size:12px;text-align:center">Loading...</div>';
  try{
    const r=await fetch('oracle_picks.json?t='+Date.now());
    if(!r.ok) throw new Error('No picks file');
    const data=await r.json();
    const picks=data.picks||[];
    // Auto-import today's picks into history if not already there
    if(picks.length){
      const d=getBettingData();
      d.oracle_picks_history=d.oracle_picks_history||[];
      picks.forEach(p=>{
        const alreadyLogged=d.oracle_picks_history.some(h=>h.pick===p.side&&h.date===data.date);
        if(!alreadyLogged){
          d.oracle_picks_history.push({
            id:Date.now().toString()+Math.random().toString(36).slice(2),
            date:data.date,
            sport:p.title.includes('NHL')?'NHL':p.title.includes('NBA')?'NBA':p.title.includes('NFL')?'NFL':p.title.includes('MLB')?'MLB':'Other',
            pick:p.side,
            odds:p.edge||'',
            pnl:0,
            result:'Pending',
            stake:10
          });
        }
      });
      saveBettingData(d);
      renderBetting();
    }
    el.innerHTML=picks.length?`
      <div style="font-size:11px;color:var(--text3);margin-bottom:12px">Generated: ${data.date}</div>
      ${picks.map(p=>`
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;background:var(--surface2);border-radius:8px;margin-bottom:8px">
          <div style="flex:1">
            <div style="font-size:13px;font-weight:600">${p.title}</div>
            <div style="font-size:11px;color:var(--text2);margin-top:2px">${p.side}</div>
          </div>
          <div style="text-align:right;margin-left:12px">
            <div style="font-size:11px;font-family:'DM Mono',monospace;color:var(--purple)">Edge: ${p.edge}</div>
            <div style="font-size:10px;color:var(--text3);margin-top:2px">${new Date(p.date).toLocaleDateString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})}</div>
          </div>
        </div>`).join('')}`
    :'<div style="padding:20px;color:var(--text3);font-size:12px;text-align:center">No picks today</div>';
  } catch(e){
    el.innerHTML='<div style="padding:20px;color:var(--text3);font-size:12px;text-align:center">No picks yet — Oracle runs at 9AM UTC</div>';
  }
}

function openBankrollModal(){
  const d=getBettingData();
  showModal(`<div class="modal-title">💰 Set Bankroll</div>
    <div class="form-group"><label class="form-label">Starting Bankroll ($)</label><input class="form-input" id="m_bkStart" type="number" value="${d.starting||0}" style="width:100%"></div>
    <div class="modal-actions" style="margin-top:14px"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-gold" onclick="saveBankroll()">Save</button></div>`);
}
function saveBankroll(){const d=getBettingData();d.starting=parseFloat(document.getElementById('m_bkStart').value)||0;saveBettingData(d);renderBetting();closeModal();}

function openAddBetModal(){
  showModal(`<div class="modal-title">+ Log Bet</div>
    <div class="form-grid">
      <div class="form-group"><label class="form-label">Date</label><input class="form-input" id="m_betDate" type="date" value="${new Date().toISOString().split('T')[0]}" style="width:100%"></div>
      <div class="form-group"><label class="form-label">Sport</label><select class="form-select" id="m_betSport" style="width:100%"><option>NBA</option><option>NFL</option><option>MLB</option><option>NHL</option><option>NCAAM</option><option>NCAAF</option><option>Soccer</option><option>Other</option></select></div>
      <div class="form-group full"><label class="form-label">Pick</label><input class="form-input" id="m_betPick" placeholder="e.g. Lakers -4.5, Over 229.5" style="width:100%"></div>
      <div class="form-group"><label class="form-label">Odds</label><input class="form-input" id="m_betOdds" placeholder="-110" style="width:100%"></div>
      <div class="form-group"><label class="form-label">Stake ($)</label><input class="form-input" id="m_betStake" type="number" style="width:100%"></div>
      <div class="form-group"><label class="form-label">P&L ($)</label><input class="form-input" id="m_betPnl" type="number" placeholder="Negative for loss" style="width:100%"></div>
      <div class="form-group"><label class="form-label">Result</label><select class="form-select" id="m_betResult" style="width:100%"><option value="Pending">Pending</option><option value="W">Win</option><option value="L">Loss</option><option value="P">Push</option></select></div>
      <div class="form-group"><label class="form-label">Capper (optional)</label><input class="form-input" id="m_betCapper" placeholder="@SharpMike" style="width:100%"></div>
    </div>
    <div class="modal-actions" style="margin-top:14px"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveBet()">Log Bet</button></div>`);
}
function saveBet(){
  try{
    const d=getBettingData();
    d.bets=d.bets||[];
    const pick=document.getElementById('m_betPick').value||'Unnamed pick';
    const bet={
      id:Date.now().toString()+Math.random().toString(36).slice(2),
      date:document.getElementById('m_betDate').value,
      sport:document.getElementById('m_betSport').value,
      pick:pick,
      odds:document.getElementById('m_betOdds').value,
      stake:parseFloat(document.getElementById('m_betStake').value)||0,
      pnl:parseFloat(document.getElementById('m_betPnl').value)||0,
      result:document.getElementById('m_betResult').value,
      capper:document.getElementById('m_betCapper').value
    };
    d.bets.push(bet);
    saveBettingData(d);
    closeModal();
    renderBetting();
    addActivity('Bet logged: '+pick);
  } catch(e){console.error('saveBet error:',e);}
}

function editBet(id){
  const d=getBettingData();const b=d.bets.find(b=>b.id===id);if(!b)return;
  showModal(`<div class="modal-title">✏️ Edit Bet</div>
    <div class="form-grid">
      <div class="form-group"><label class="form-label">Date</label><input class="form-input" id="m_betDate" type="date" value="${b.date||''}" style="width:100%"></div>
      <div class="form-group"><label class="form-label">Sport</label><select class="form-select" id="m_betSport" style="width:100%"><option ${b.sport==='NBA'?'selected':''}>NBA</option><option ${b.sport==='NFL'?'selected':''}>NFL</option><option ${b.sport==='MLB'?'selected':''}>MLB</option><option ${b.sport==='NHL'?'selected':''}>NHL</option><option ${b.sport==='NCAAM'?'selected':''}>NCAAM</option><option ${b.sport==='NCAAF'?'selected':''}>NCAAF</option><option ${b.sport==='Soccer'?'selected':''}>Soccer</option><option ${b.sport==='Other'?'selected':''}>Other</option></select></div>
      <div class="form-group full"><label class="form-label">Pick</label><input class="form-input" id="m_betPick" value="${b.pick||''}" style="width:100%"></div>
      <div class="form-group"><label class="form-label">Odds</label><input class="form-input" id="m_betOdds" value="${b.odds||''}" style="width:100%"></div>
      <div class="form-group"><label class="form-label">Stake ($)</label><input class="form-input" id="m_betStake" type="number" value="${b.stake||0}" style="width:100%"></div>
      <div class="form-group"><label class="form-label">P&L ($)</label><input class="form-input" id="m_betPnl" type="number" value="${b.pnl||0}" style="width:100%"></div>
      <div class="form-group"><label class="form-label">Result</label><select class="form-select" id="m_betResult" style="width:100%"><option value="Pending" ${b.result==='Pending'?'selected':''}>Pending</option><option value="W" ${b.result==='W'?'selected':''}>Win</option><option value="L" ${b.result==='L'?'selected':''}>Loss</option><option value="P" ${b.result==='P'?'selected':''}>Push</option></select></div>
      <div class="form-group"><label class="form-label">Capper</label><input class="form-input" id="m_betCapper" value="${b.capper||''}" style="width:100%"></div>
    </div>
    <div class="modal-actions" style="margin-top:14px">
      <button class="btn btn-danger" onclick="deleteBet('${id}')">Delete</button>
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveEditBet('${id}')">Save</button>
    </div>`);
}
function saveEditBet(id){
  try{
    const d=getBettingData();
    const idx=d.bets.findIndex(b=>b.id===id);
    if(idx<0)return;
    d.bets[idx]={...d.bets[idx],
      date:document.getElementById('m_betDate').value,
      sport:document.getElementById('m_betSport').value,
      pick:document.getElementById('m_betPick').value,
      odds:document.getElementById('m_betOdds').value,
      stake:parseFloat(document.getElementById('m_betStake').value)||0,
      pnl:parseFloat(document.getElementById('m_betPnl').value)||0,
      result:document.getElementById('m_betResult').value,
      capper:document.getElementById('m_betCapper').value
    };
    saveBettingData(d);closeModal();renderBetting();
  } catch(e){console.error('saveEditBet error:',e);}
}
function deleteBet(id){if(!confirm('Delete this bet?'))return;const d=getBettingData();d.bets=d.bets.filter(b=>b.id!==id);saveBettingData(d);renderBetting();closeModal();}

function showModal(html){document.getElementById('modalContent').innerHTML=html;document.getElementById('modalOverlay').classList.add('open');}
function closeModal(){document.getElementById('modalOverlay').classList.remove('open');}
document.getElementById('modalOverlay').addEventListener('click',e=>{if(e.target===document.getElementById('modalOverlay'))closeModal();});
document.addEventListener('keydown',e=>{
  if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();document.getElementById('searchInput').focus();}
  if(e.key==='Escape'){closeModal();closePanel();}
});

