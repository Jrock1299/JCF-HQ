<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JCF HQ — Mission Control</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* ============================================================
   JCF HQ — CSS VARIABLES & RESET
   ============================================================ */
:root {
  --bg: #050508;
  --bg2: #08080f;
  --surface: rgba(255,255,255,0.03);
  --surface2: rgba(255,255,255,0.06);
  --border: rgba(255,255,255,0.06);
  --border2: rgba(255,255,255,0.12);
  --blue: #00d4ff;
  --blue-dim: rgba(0,212,255,0.15);
  --blue-glow: rgba(0,212,255,0.3);
  --gold: #ffd166;
  --gold-dim: rgba(255,209,102,0.15);
  --gold-glow: rgba(255,209,102,0.3);
  --green: #3ddc84;
  --red: #ff5b5b;
  --purple: #c084fc;
  --text: #e8eaf0;
  --text2: #8892a4;
  --text3: #4a5568;
  --radius: 16px;
  --radius-sm: 10px;
  --gap: 20px;
}
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}
body::before {
  content: '';
  position: fixed;
  top: -50%;
  left: -20%;
  width: 60%;
  height: 80%;
  background: radial-gradient(ellipse, rgba(0,212,255,0.04) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}
body::after {
  content: '';
  position: fixed;
  bottom: -30%;
  right: -10%;
  width: 50%;
  height: 70%;
  background: radial-gradient(ellipse, rgba(255,209,102,0.03) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* ============================================================
   HEADER
   ============================================================ */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(5,5,8,0.8);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-bottom: 1px solid var(--border);
  padding: 0 2.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
}
.header-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}
.logo-mark {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, var(--blue), var(--gold));
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: 14px;
  color: #050508;
  letter-spacing: -0.5px;
}
.logo-text {
  font-family: 'Syne', sans-serif;
  font-weight: 700;
  font-size: 16px;
  letter-spacing: 0.05em;
  color: var(--text);
}
.logo-text span { color: var(--gold); }
.header-nav {
  display: flex;
  align-items: center;
  gap: 4px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 4px;
}
.nav-tab {
  padding: 7px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text2);
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
  border: none;
  background: none;
}
.nav-tab:hover { color: var(--text); background: var(--surface2); }
.nav-tab.active {
  color: var(--bg);
  background: linear-gradient(135deg, var(--blue), #0099cc);
  box-shadow: 0 0 16px var(--blue-glow);
}
.header-right {
  display: flex;
  align-items: center;
  gap: 12px;
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 14px;
  transition: all 0.2s;
}
.search-bar:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px var(--blue-dim); }
.search-bar input {
  background: none;
  border: none;
  outline: none;
  color: var(--text);
  font-size: 13px;
  font-family: 'DM Sans', sans-serif;
  width: 160px;
}
.search-bar input::placeholder { color: var(--text3); }
.search-hint { font-size: 10px; color: var(--text3); font-family: 'DM Mono', monospace; }
.status-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 8px var(--green);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 8px var(--green); }
  50% { opacity: 0.5; box-shadow: 0 0 3px var(--green); }
}

/* ============================================================
   MAIN LAYOUT
   ============================================================ */
.main {
  max-width: 1600px;
  margin: 0 auto;
  padding: 2.5rem;
  position: relative;
  z-index: 1;
}
.tab-content { display: none; animation: fadeInUp 0.3s ease; }
.tab-content.active { display: block; }
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============================================================
   CARDS & GLASS
   ============================================================ */
.glass-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  backdrop-filter: blur(12px);
  padding: 24px;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.glass-card:hover { border-color: var(--border2); }
.card-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text2);
  margin-bottom: 16px;
}
.section-title {
  font-family: 'Syne', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20px;
}

/* ============================================================
   DASHBOARD TAB
   ============================================================ */
.welcome-bar {
  background: linear-gradient(135deg, rgba(0,212,255,0.08), rgba(255,209,102,0.06));
  border: 1px solid rgba(0,212,255,0.15);
  border-radius: var(--radius);
  padding: 20px 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--gap);
}
.welcome-greeting {
  font-family: 'Syne', sans-serif;
  font-size: 22px;
  font-weight: 700;
}
.welcome-greeting span { color: var(--blue); }
.welcome-date { font-size: 13px; color: var(--text2); font-family: 'DM Mono', monospace; margin-top: 4px; }
.welcome-goal { text-align: right; }
.welcome-goal-label { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: 0.1em; }
.welcome-goal-value { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; color: var(--gold); }

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap);
  margin-bottom: var(--gap);
}
.metric-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
  position: relative;
  overflow: hidden;
  transition: all 0.2s;
}
.metric-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
}
.metric-card.blue::before { background: linear-gradient(90deg, var(--blue), transparent); }
.metric-card.gold::before { background: linear-gradient(90deg, var(--gold), transparent); }
.metric-card.green::before { background: linear-gradient(90deg, var(--green), transparent); }
.metric-card.purple::before { background: linear-gradient(90deg, var(--purple), transparent); }
.metric-card:hover { border-color: var(--border2); transform: translateY(-2px); }
.metric-icon { font-size: 22px; margin-bottom: 12px; }
.metric-label { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; }
.metric-value { font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800; line-height: 1; }
.metric-value.blue { color: var(--blue); }
.metric-value.gold { color: var(--gold); }
.metric-value.green { color: var(--green); }
.metric-value.purple { color: var(--purple); }
.metric-trend { font-size: 11px; color: var(--text2); margin-top: 8px; display: flex; align-items: center; gap: 4px; }
.trend-up { color: var(--green); }
.trend-down { color: var(--red); }
.progress-bar-wrap { margin-top: 10px; background: var(--surface2); border-radius: 4px; height: 4px; overflow: hidden; }
.progress-bar-fill { height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--blue), var(--gold)); transition: width 0.8s ease; }

.dashboard-grid { display: grid; grid-template-columns: 1fr 380px; gap: var(--gap); }

.activity-feed { max-height: 320px; overflow-y: auto; }
.activity-feed::-webkit-scrollbar { width: 4px; }
.activity-feed::-webkit-scrollbar-track { background: transparent; }
.activity-feed::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 4px; }
.activity-item {
  display: flex;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
  align-items: flex-start;
}
.activity-item:last-child { border-bottom: none; }
.activity-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); margin-top: 5px; flex-shrink: 0; }
.activity-dot.gold { background: var(--gold); }
.activity-dot.green { background: var(--green); }
.activity-text { font-size: 13px; color: var(--text); flex: 1; }
.activity-time { font-size: 11px; color: var(--text3); font-family: 'DM Mono', monospace; white-space: nowrap; }

.priorities-list { list-style: none; }
.priority-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--surface2);
  border-radius: var(--radius-sm);
  margin-bottom: 8px;
  cursor: pointer;
  transition: all 0.15s;
}
.priority-item:hover { border-color: var(--border2); background: rgba(255,255,255,0.07); }
.priority-item.done .priority-text { text-decoration: line-through; color: var(--text3); }
.priority-check {
  width: 18px; height: 18px;
  border: 2px solid var(--border2);
  border-radius: 5px;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s;
}
.priority-item.done .priority-check { background: var(--blue); border-color: var(--blue); }
.priority-text { font-size: 13px; flex: 1; }
.add-btn {
  width: 100%;
  padding: 10px;
  border: 1px dashed var(--border2);
  border-radius: var(--radius-sm);
  background: none;
  color: var(--text2);
  font-size: 13px;
  cursor: pointer;
  transition: all 0.15s;
  font-family: 'DM Sans', sans-serif;
  margin-top: 4px;
}
.add-btn:hover { border-color: var(--blue); color: var(--blue); }

/* ============================================================
   PROJECTS / KANBAN
   ============================================================ */
.kanban-board { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
.kanban-col { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
.kanban-col-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.kanban-col-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 14px; }
.kanban-count { background: var(--surface2); border-radius: 20px; padding: 2px 10px; font-size: 12px; color: var(--text2); font-family: 'DM Mono', monospace; }
.task-card {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: all 0.15s;
  position: relative;
}
.task-card:hover { border-color: var(--border2); transform: translateY(-1px); }
.task-title { font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.task-desc { font-size: 12px; color: var(--text2); margin-bottom: 10px; line-height: 1.5; }
.task-footer { display: flex; justify-content: space-between; align-items: center; }
.priority-badge { font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em; }
.priority-badge.high { background: rgba(255,91,91,0.15); color: var(--red); }
.priority-badge.medium { background: rgba(255,209,102,0.15); color: var(--gold); }
.priority-badge.low { background: rgba(61,220,132,0.15); color: var(--green); }
.task-date { font-size: 10px; color: var(--text3); font-family: 'DM Mono', monospace; }

/* ============================================================
   TIMELINE
   ============================================================ */
.timeline { position: relative; padding-left: 40px; }
.timeline::before {
  content: '';
  position: absolute;
  left: 12px; top: 0; bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, var(--blue), var(--gold), transparent);
}
.phase {
  position: relative;
  margin-bottom: 40px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  transition: all 0.2s;
}
.phase.current {
  border-color: rgba(0,212,255,0.3);
  box-shadow: 0 0 24px rgba(0,212,255,0.08);
}
.phase::before {
  content: '';
  position: absolute;
  left: -34px;
  top: 28px;
  width: 12px; height: 12px;
  border-radius: 50%;
  background: var(--blue);
  box-shadow: 0 0 12px var(--blue-glow);
  border: 2px solid var(--bg);
}
.phase.done::before { background: var(--green); box-shadow: 0 0 12px rgba(61,220,132,0.4); }
.phase.future::before { background: var(--text3); box-shadow: none; }
.phase-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
.phase-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 16px; }
.phase-dates { font-size: 12px; color: var(--text2); font-family: 'DM Mono', monospace; }
.phase-badge { font-size: 10px; font-weight: 600; padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.08em; }
.phase-badge.current { background: var(--blue-dim); color: var(--blue); }
.phase-badge.done { background: rgba(61,220,132,0.15); color: var(--green); }
.phase-badge.upcoming { background: var(--surface2); color: var(--text2); }
.phase-desc { font-size: 13px; color: var(--text2); line-height: 1.6; margin-bottom: 16px; }
.milestone-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.milestone { display: flex; align-items: center; gap: 10px; font-size: 13px; }
.milestone-check { font-size: 14px; }
.milestone.done { color: var(--text2); }
.milestone.pending { color: var(--text); }

/* ============================================================
   NOTES
   ============================================================ */
.notes-container { display: flex; flex-direction: column; gap: 12px; }
.notes-meta { display: flex; justify-content: space-between; font-size: 12px; color: var(--text2); font-family: 'DM Mono', monospace; }
.notes-area {
  width: 100%;
  min-height: 480px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  color: var(--text);
  font-size: 14px;
  font-family: 'DM Mono', monospace;
  line-height: 1.8;
  resize: vertical;
  outline: none;
  transition: border-color 0.2s;
}
.notes-area:focus { border-color: var(--blue); box-shadow: 0 0 0 3px var(--blue-dim); }
.notes-area::placeholder { color: var(--text3); }

/* ============================================================
   REVENUE TAB
   ============================================================ */
.revenue-grid { display: grid; grid-template-columns: 300px 1fr; gap: var(--gap); margin-bottom: var(--gap); }
.gauge-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px; }
.gauge-svg { position: relative; }
.gauge-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.gauge-pct { font-family: 'Syne', sans-serif; font-size: 32px; font-weight: 800; color: var(--gold); }
.gauge-sub { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: 0.1em; }
.chart-bars { display: flex; align-items: flex-end; gap: 12px; height: 160px; padding: 0 8px; }
.chart-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.chart-bar { width: 100%; border-radius: 6px 6px 0 0; background: linear-gradient(180deg, var(--blue), rgba(0,212,255,0.3)); transition: height 0.8s ease; min-height: 4px; }
.chart-bar.gold { background: linear-gradient(180deg, var(--gold), rgba(255,209,102,0.3)); }
.chart-label { font-size: 11px; color: var(--text2); font-family: 'DM Mono', monospace; }
.chart-val { font-size: 10px; color: var(--text3); font-family: 'DM Mono', monospace; }

.agents-pnl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); margin-bottom: var(--gap); }
.agent-pnl-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; position: relative; overflow: hidden; }
.agent-pnl-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
.agent-pnl-card.crisp::before { background: linear-gradient(90deg, var(--blue), transparent); }
.agent-pnl-card.blade::before { background: linear-gradient(90deg, var(--gold), transparent); }
.agent-pnl-card.oracle::before { background: linear-gradient(90deg, var(--purple), transparent); }
.agent-pnl-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 15px; margin-bottom: 4px; }
.agent-pnl-role { font-size: 11px; color: var(--text2); margin-bottom: 16px; }
.agent-pnl-val { font-family: 'DM Mono', monospace; font-size: 24px; font-weight: 500; }
.agent-pnl-val.pos { color: var(--green); }
.agent-pnl-val.neg { color: var(--red); }
.agent-pnl-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }
.agent-pnl-stat { background: var(--surface2); border-radius: 8px; padding: 8px 10px; }
.agent-pnl-stat-label { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.08em; }
.agent-pnl-stat-val { font-size: 13px; font-weight: 600; font-family: 'DM Mono', monospace; margin-top: 2px; }

.clients-list { display: flex; flex-direction: column; gap: 8px; }
.client-row { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: var(--surface2); border-radius: var(--radius-sm); }
.client-name { font-size: 14px; font-weight: 600; flex: 1; }
.client-mrr { font-family: 'DM Mono', monospace; font-size: 14px; color: var(--gold); }
.client-delete { color: var(--text3); cursor: pointer; font-size: 16px; transition: color 0.15s; }
.client-delete:hover { color: var(--red); }

.projection-card { background: linear-gradient(135deg, rgba(0,212,255,0.06), rgba(255,209,102,0.04)); border: 1px solid rgba(0,212,255,0.15); border-radius: var(--radius); padding: 24px; }
.proj-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; }
.proj-item { text-align: center; }
.proj-label { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; }
.proj-value { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; }

/* ============================================================
   COMMAND CENTER
   ============================================================ */
.agents-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); margin-bottom: var(--gap); }
.agent-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.agent-card:hover { border-color: var(--border2); transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
.agent-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.agent-avatar { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
.agent-avatar.blue { background: var(--blue-dim); }
.agent-avatar.gold { background: var(--gold-dim); }
.agent-avatar.purple { background: rgba(192,132,252,0.15); }
.agent-avatar.green { background: rgba(61,220,132,0.15); }
.agent-status-wrap { display: flex; align-items: center; gap: 6px; }
.agent-status-dot { width: 8px; height: 8px; border-radius: 50%; }
.agent-status-dot.online { background: var(--green); box-shadow: 0 0 6px var(--green); animation: pulse 2s infinite; }
.agent-status-dot.busy { background: var(--gold); box-shadow: 0 0 6px var(--gold); }
.agent-status-dot.offline { background: var(--text3); }
.agent-status-text { font-size: 11px; color: var(--text2); }
.agent-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 16px; margin-bottom: 2px; }
.agent-role { font-size: 12px; color: var(--text2); margin-bottom: 14px; }
.agent-model { font-size: 10px; font-family: 'DM Mono', monospace; color: var(--blue); background: var(--blue-dim); padding: 3px 8px; border-radius: 4px; display: inline-block; margin-bottom: 10px; }
.agent-last-active { font-size: 11px; color: var(--text3); font-family: 'DM Mono', monospace; }

.slide-panel {
  position: fixed;
  top: 0; right: -480px;
  width: 480px; height: 100%;
  background: rgba(8,8,15,0.95);
  backdrop-filter: blur(24px);
  border-left: 1px solid var(--border);
  z-index: 200;
  transition: right 0.3s ease;
  overflow-y: auto;
  padding: 32px;
}
.slide-panel.open { right: 0; }
