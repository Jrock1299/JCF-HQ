    <div class="form-group mb-4"><label class="form-label">Monthly Revenue Goal ($)</label><input class="form-input" id="m_revGoal" value="${data.goal}" type="number" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Add Month (label)</label><input class="form-input" id="m_monthLabel" placeholder="e.g. Mar 2026" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Month Revenue ($)</label><input class="form-input" id="m_monthVal" type="number" placeholder="0" style="width:100%"></div>
