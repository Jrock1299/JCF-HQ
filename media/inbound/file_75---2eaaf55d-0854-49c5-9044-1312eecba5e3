/* ============================================================
   REVENUE TAB
   ============================================================ */
function renderRevenue() {
  const data = S.get('revenue') || { goal: 10000, months: [], clients: [], agentStats: {} };
  const mrr = (data.clients || []).reduce((s, c) => s + (c.mrr || 0), 0);
  const goal = data.goal || 10000;
  const pct = Math.min(100, (mrr / goal) * 100);
  const circ = 440;
  document.getElementById('gaugePct').textContent = pct.toFixed(0) + '%';
  document.getElementById('gaugeArc').style.strokeDashoffset = circ - (circ * pct / 100);
  document.getElementById('mrrDisplay').textContent = '$' + mrr.toLocaleString();
  document.getElementById('goalDisplay').textContent = '$' + goal.toLocaleString();

  // Chart
  const months = data.months || [];
  const maxVal = Math.max(...months.map(m => m.val), 1);
  document.getElementById('revChart').innerHTML = months.slice(-6).map((m, i) => `
    <div class="chart-bar-wrap">
      <div class="chart-val">$${m.val >= 1000 ? (m.val/1000).toFixed(1)+'K' : m.val}</div>
      <div class="chart-bar ${i === months.length-1 ? 'gold' : ''}" style="height:${Math.max(8, (m.val/maxVal)*140)}px"></div>
      <div class="chart-label">${m.label}</div>
    </div>
  `).join('') || '<div style="color:var(--text3);font-size:12px;padding:20px">No revenue data yet</div>';

  // Clients
  document.getElementById('clientsList').innerHTML = (data.clients || []).map((c, i) => `
    <div class="client-row">
      <div class="client-name">${c.name}</div>
      <div class="client-mrr">$${c.mrr.toLocaleString()}/mo</div>
      <div class="client-delete" onclick="deleteClient(${i})">✕</div>
    </div>
  `).join('') || '<div style="color:var(--text3);font-size:13px;padding:12px">No revenue streams added yet</div>';

  // Projections
  const annual = mrr * 12;
  document.getElementById('projAnnual').textContent = '$' + annual.toLocaleString();
  const monthsNeeded = mrr > 0 ? Math.ceil((goal * 12 - annual) / mrr) : Infinity;
  document.getElementById('projGrowth').textContent = mrr > 0 ? '$' + Math.max(0, goal - mrr).toLocaleString() + '/mo needed' : 'Add revenue';
  if (mrr > 0 && monthsNeeded < 120) {
    const goalDate = new Date();
    goalDate.setMonth(goalDate.getMonth() + monthsNeeded);
    document.getElementById('projDate').textContent = goalDate.toLocaleDateString('en-US', { month:'short', year:'numeric' });
  } else {
    document.getElementById('projDate').textContent = mrr > 0 ? '2030+' : '—';
  }
}

