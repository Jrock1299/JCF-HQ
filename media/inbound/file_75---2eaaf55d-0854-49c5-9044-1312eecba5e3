<script>
/* ============================================================
   DATA LAYER — localStorage helpers
   ============================================================ */
const S = {
  get: k => { try { return JSON.parse(localStorage.getItem('jcf_' + k)) } catch(e) { return null } },
  set: (k, v) => localStorage.setItem('jcf_' + k, JSON.stringify(v)),
};

/* ============================================================
   NAVIGATION
   ============================================================ */
function switchTab(tab) {
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-' + tab).classList.add('active');
  event.target.classList.add('active');
  if (tab === 'revenue') renderRevenue();
  if (tab === 'command') renderAgents();
  if (tab === 'intel') renderIntel();
  if (tab === 'basketball') renderBasketball();
}

/* ============================================================
   LIVE CLOCK & WELCOME
   ============================================================ */
function updateClock() {
  const now = new Date();
  const h = now.getHours();
  document.getElementById('timeOfDay').textContent = h < 12 ? 'morning' : h < 17 ? 'afternoon' : 'evening';
  document.getElementById('liveDate').textContent = now.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) + ' · ' + now.toLocaleTimeString();
  const goal2030 = new Date('2030-01-01');
  const daysLeft = Math.ceil((goal2030 - now) / 86400000);
  document.getElementById('daysLeft').textContent = daysLeft.toLocaleString();
}
setInterval(updateClock, 1000);
updateClock();

/* ============================================================
   DASHBOARD — Net Worth
   ============================================================ */
function updateNetWorth() {
  const data = S.get('networth') || { current: 0, goal: 10000000 };
  const pct = Math.min(100, (data.current / data.goal) * 100);
  const fmt = n => n >= 1000000 ? '$' + (n/1000000).toFixed(2) + 'M' : n >= 1000 ? '$' + (n/1000).toFixed(1) + 'K' : '$' + n;
  document.getElementById('nwPct').textContent = pct.toFixed(1) + '%';
  document.getElementById('nwBar').style.width = pct + '%';
  document.getElementById('netWorthDisplay').textContent = fmt(data.current) + ' / ' + fmt(data.goal);
}

function openNetWorthModal() {
  const data = S.get('networth') || { current: 0, goal: 10000000 };
  showModal(`
    <div class="modal-title">💎 Net Worth Tracker</div>
    <div class="form-group mb-4"><label class="form-label">Current Net Worth ($)</label><input class="form-input" id="m_nwCurrent" value="${data.current}" type="number" style="width:100%"></div>
    <div class="form-group"><label class="form-label">Goal ($)</label><input class="form-input" id="m_nwGoal" value="${data.goal}" type="number" style="width:100%"></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveNetWorth()">Save</button>
    </div>
  `);
}
function saveNetWorth() {
  S.set('networth', { current: parseFloat(document.getElementById('m_nwCurrent').value) || 0, goal: parseFloat(document.getElementById('m_nwGoal').value) || 10000000 });
  updateNetWorth();
  closeModal();
}

/* ============================================================
   DASHBOARD — Activity Feed
   ============================================================ */
function renderActivityFeed() {
  const items = S.get('activity') || [
    { text: 'JCF HQ initialized — Mission Control online', time: new Date().toISOString(), color: 'blue' },
    { text: 'Crisp & Blade paper trading sessions configured', time: new Date().toISOString(), color: 'gold' },
    { text: 'Oracle intelligence system activated', time: new Date().toISOString(), color: 'green' },
  ];
  const feed = document.getElementById('activityFeed');
  feed.innerHTML = items.slice(-20).reverse().map(item => `
    <div class="activity-item">
      <div class="activity-dot ${item.color || 'blue'}"></div>
      <div class="activity-text">${item.text}</div>
      <div class="activity-time">${timeAgo(item.time)}</div>
    </div>
  `).join('');
}

function addActivity(text) {
  if (!text) {
    const t = prompt('New activity:');
    if (!t) return;
    text = t;
  }
  const items = S.get('activity') || [];
  items.push({ text, time: new Date().toISOString(), color: 'blue' });
  S.set('activity', items);
  renderActivityFeed();
}

function timeAgo(iso) {
  const diff = Date.now() - new Date(iso);
  if (diff < 60000) return 'just now';
  if (diff < 3600000) return Math.floor(diff/60000) + 'm ago';
  if (diff < 86400000) return Math.floor(diff/3600000) + 'h ago';
  return Math.floor(diff/86400000) + 'd ago';
}

/* ============================================================
   DASHBOARD — Priorities
   ============================================================ */
function renderPriorities() {
  const items = S.get('priorities') || [
    { text: 'Review trading session results', done: false },
    { text: 'Check Oracle intelligence report', done: false },
    { text: 'Training session — shooting drills', done: false },
  ];
  const list = document.getElementById('prioritiesList');
  list.innerHTML = items.map((item, i) => `
    <li class="priority-item ${item.done ? 'done' : ''}" onclick="togglePriority(${i})">
      <div class="priority-check">${item.done ? '✓' : ''}</div>
      <span class="priority-text">${item.text}</span>
    </li>
  `).join('');
  const remaining = items.filter(i => !i.done).length;
  document.getElementById('prioritiesCount').textContent = remaining;
}

function togglePriority(i) {
  const items = S.get('priorities') || [];
  items[i].done = !items[i].done;
  S.set('priorities', items);
  renderPriorities();
}

function addPriority() {
  const t = prompt('New priority:');
  if (!t) return;
  const items = S.get('priorities') || [];
  items.push({ text: t, done: false });
  S.set('priorities', items);
  renderPriorities();
}

/* ============================================================
   PROJECTS — Kanban
   ============================================================ */
function renderKanban() {
  const tasks = S.get('tasks') || [];
  ['backlog','inprogress','done'].forEach(col => {
    const colTasks = tasks.filter(t => t.status === col);
    document.getElementById('tasks-' + col).innerHTML = colTasks.map(t => `
      <div class="task-card" onclick="editTask('${t.id}')">
        <div class="task-title">${t.title}</div>
        <div class="task-desc">${t.desc || ''}</div>
        <div class="task-footer">
          <span class="priority-badge ${t.priority}">${t.priority}</span>
          <span class="task-date">${t.created ? new Date(t.created).toLocaleDateString() : ''}</span>
        </div>
      </div>
    `).join('');
    document.getElementById('count-' + col).textContent = colTasks.length;
  });
  const inProgress = tasks.filter(t => t.status === 'inprogress').length;
  document.getElementById('activeProjectsCount').textContent = inProgress;
}

function openTaskModal(status = 'backlog') {
  showModal(`
    <div class="modal-title">📋 New Task</div>
    <div class="form-group mb-4"><label class="form-label">Title</label><input class="form-input" id="m_taskTitle" placeholder="Task title" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Description</label><textarea class="form-textarea" id="m_taskDesc" placeholder="Details..." style="width:100%"></textarea></div>
    <div class="form-group mb-4">
      <label class="form-label">Priority</label>
      <select class="form-select" id="m_taskPriority" style="width:100%">
        <option value="high">🔴 High</option>
        <option value="medium" selected>🟡 Medium</option>
        <option value="low">🟢 Low</option>
      </select>
    </div>
    <div class="form-group mb-4">
      <label class="form-label">Status</label>
      <select class="form-select" id="m_taskStatus" style="width:100%">
        <option value="backlog" ${status==='backlog'?'selected':''}>Backlog</option>
        <option value="inprogress" ${status==='inprogress'?'selected':''}>In Progress</option>
        <option value="done" ${status==='done'?'selected':''}>Done</option>
      </select>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveTask()">Add Task</button>
    </div>
  `);
}

function saveTask(id) {
  const tasks = S.get('tasks') || [];
  const task = {
    id: id || Date.now().toString(),
    title: document.getElementById('m_taskTitle').value || 'Untitled',
    desc: document.getElementById('m_taskDesc').value,
    priority: document.getElementById('m_taskPriority').value,
    status: document.getElementById('m_taskStatus').value,
    created: new Date().toISOString(),
  };
  if (id) { const idx = tasks.findIndex(t => t.id === id); if (idx >= 0) tasks[idx] = task; }
  else tasks.push(task);
  S.set('tasks', tasks);
  renderKanban();
  closeModal();
  addActivity('Task added: ' + task.title);
}

function editTask(id) {
  const tasks = S.get('tasks') || [];
  const t = tasks.find(t => t.id === id);
  if (!t) return;
  showModal(`
    <div class="modal-title">✏️ Edit Task</div>
    <div class="form-group mb-4"><label class="form-label">Title</label><input class="form-input" id="m_taskTitle" value="${t.title}" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Description</label><textarea class="form-textarea" id="m_taskDesc" style="width:100%">${t.desc||''}</textarea></div>
    <div class="form-group mb-4"><label class="form-label">Priority</label>
      <select class="form-select" id="m_taskPriority" style="width:100%">
        <option value="high" ${t.priority==='high'?'selected':''}>🔴 High</option>
        <option value="medium" ${t.priority==='medium'?'selected':''}>🟡 Medium</option>
        <option value="low" ${t.priority==='low'?'selected':''}>🟢 Low</option>
      </select></div>
    <div class="form-group mb-4"><label class="form-label">Status</label>
      <select class="form-select" id="m_taskStatus" style="width:100%">
        <option value="backlog" ${t.status==='backlog'?'selected':''}>Backlog</option>
        <option value="inprogress" ${t.status==='inprogress'?'selected':''}>In Progress</option>
        <option value="done" ${t.status==='done'?'selected':''}>Done</option>
      </select></div>
    <div class="modal-actions">
      <button class="btn btn-danger" onclick="deleteTask('${id}')">Delete</button>
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveTask('${id}')">Save</button>
    </div>
  `);
}

function deleteTask(id) {
  let tasks = S.get('tasks') || [];
  tasks = tasks.filter(t => t.id !== id);
  S.set('tasks', tasks);
  renderKanban();
  closeModal();
}

