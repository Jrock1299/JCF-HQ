def wait_for_candle_close():
    """Wait for the current 15m candle to close so we get a complete opening range."""
    from datetime import datetime, timezone
    now = datetime.now(timezone.utc)
    minutes_into_candle = now.minute % 15
    wait_seconds = (15 - minutes_into_candle) * 60 - now.second
    if wait_seconds > 0 and wait_seconds < 900:
        print(f"\\u23f3 Waiting {wait_seconds}s for 15m candle close...")
        time.sleep(wait_seconds + 5)  # 5s buffer for candle to finalize


def get_opening_candle(instrument):
    """
    Fetch the most recent closed 15m candle from OANDA and return its high/low.
    This represents the Opening Range for the session.
    
    OANDA candle format:
        candle['mid']['h'] = high
        candle['mid']['l'] = low
        candle['mid']['o'] = open
        candle['mid']['c'] = close
        candle['complete'] = True/False
    """
    try:
        print(f"\\U0001f4ca Recording opening 15m candle for {instrument}...")
        candles = get_candles(instrument, 'M15', 3)
        if not candles:
            print(f"\\u274c No candles returned for {instrument}")
            return None, None
        
        # Find the last COMPLETE candle
        complete_candles = [c for c in candles if c.get('complete', False)]
        if not complete_candles:
            print(f"\\u274c No complete 15m candles for {instrument}")
            return None, None
        
        opening_candle = complete_candles[-1]
        high = float(opening_candle['mid']['h'])
        low = float(opening_candle['mid']['l'])
        print(f"\\U0001f4ca {instrument} ORB marked — High: {high} Low: {low}")
        return high, low
    except Exception as e:
        print(f"\\u274c Error getting opening candle for {instrument}: {e}")
        logging.error(f"get_opening_candle error for {instrument}: {e}")
        return None, None


def check_1m_breakout(instrument, orb_high, orb_low):
    """
    Check the last closed 1m candle for a breakout above ORB high or below ORB low.
    
    Entry criteria (same as Crisp):
    - LONG: candle close > ORB high AND candle open > ORB high (clean break, not a wick)
    - SHORT: candle close < ORB low AND candle open < ORB low
    
    Returns: 'long', 'short', or None
    """
    try:
        candles = get_candles(instrument, 'M1', 3)
        if not candles:
            return None
        
        # Get last complete candle
        complete_candles = [c for c in candles if c.get('complete', False)]
        if not complete_candles:
            return None
        
        last_closed = complete_candles[-1]
        close_price = float(last_closed['mid']['c'])
        open_price = float(last_closed['mid']['o'])
        
        if close_price > orb_high and open_price > orb_high:
            return 'long'
        elif close_price < orb_low and open_price < orb_low:
            return 'short'
        return None
    except Exception as e:
        logging.error(f"check_1m_breakout error for {instrument}: {e}")
        return None
