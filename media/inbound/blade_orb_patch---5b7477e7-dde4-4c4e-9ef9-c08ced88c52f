def wait_for_session_open(session_name):
    """Wait until the session open time (UTC)."""
    from datetime import datetime, timezone
    sess = SESSION_TIMES.get(session_name.upper(), SESSION_TIMES['NY'])
    while True:
        now = datetime.now(timezone.utc)
        if now.hour > sess['open_hour'] or (now.hour == sess['open_hour'] and now.minute >= sess['open_min']):
