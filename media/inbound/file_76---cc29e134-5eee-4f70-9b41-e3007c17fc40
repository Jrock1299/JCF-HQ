<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JCF HQ — Mission Control</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #050508;
  --bg2: #08080f;
  --surface: rgba(255,255,255,0.03);
  --surface2: rgba(255,255,255,0.06);
  --border: rgba(255,255,255,0.06);
  --border2: rgba(255,255,255,0.12);
  --blue: #00d4ff;
  --blue-dim: rgba(0,212,255,0.15);
  --blue-glow: rgba(0,212,255,0.3);
  --gold: #ffd166;
  --gold-dim: rgba(255,209,102,0.15);
  --gold-glow: rgba(255,209,102,0.3);
  --green: #3ddc84;
  --red: #ff5b5b;
  --purple: #c084fc;
  --text: #e8eaf0;
  --text2: #8892a4;
  --text3: #4a5568;
  --radius: 16px;
  --radius-sm: 10px;
  --gap: 20px;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;top:-50%;left:-20%;width:60%;height:80%;background:radial-gradient(ellipse,rgba(0,212,255,0.04) 0%,transparent 70%);pointer-events:none;z-index:0}
body::after{content:'';position:fixed;bottom:-30%;right:-10%;width:50%;height:70%;background:radial-gradient(ellipse,rgba(255,209,102,0.03) 0%,transparent 70%);pointer-events:none;z-index:0}

/* HEADER */
.header{position:sticky;top:0;z-index:100;background:rgba(5,5,8,0.85);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:60px;gap:16px}
.logo-mark{width:34px;height:34px;background:linear-gradient(135deg,var(--blue),var(--gold));border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:13px;color:#050508;flex-shrink:0}
.logo-text{font-family:'Syne',sans-serif;font-weight:700;font-size:15px;letter-spacing:.05em;white-space:nowrap}
.logo-text span{color:var(--gold)}
.header-nav{display:flex;align-items:center;gap:3px;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:3px;flex-shrink:0}
.nav-tab{padding:6px 11px;border-radius:7px;font-size:12px;font-weight:500;color:var(--text2);cursor:pointer;transition:all .2s;white-space:nowrap;border:none;background:none;font-family:'DM Sans',sans-serif}
.nav-tab:hover{color:var(--text);background:var(--surface2)}
.nav-tab.active{color:#050508;background:linear-gradient(135deg,var(--blue),#0099cc);box-shadow:0 0 14px var(--blue-glow)}
.search-bar{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:7px 12px;transition:all .2s}
.search-bar:focus-within{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-dim)}
.search-bar input{background:none;border:none;outline:none;color:var(--text);font-size:12px;font-family:'DM Sans',sans-serif;width:140px}
.search-bar input::placeholder{color:var(--text3)}
.search-hint{font-size:10px;color:var(--text3);font-family:'DM Mono',monospace}
.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 7px var(--green);animation:pulse 2s infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 7px var(--green)}50%{opacity:.5;box-shadow:0 0 3px var(--green)}}

/* LAYOUT */
.main{max-width:1600px;margin:0 auto;padding:2rem;position:relative;z-index:1}
.tab-content{display:none;animation:fadeInUp .3s ease}
.tab-content.active{display:block}
@keyframes fadeInUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}

/* CARDS */
.glass-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);backdrop-filter:blur(12px);padding:22px;transition:border-color .2s}
.glass-card:hover{border-color:var(--border2)}
.card-label{font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--text2);margin-bottom:14px}
.section-title{font-family:'Syne',sans-serif;font-size:17px;font-weight:700;color:var(--text);margin-bottom:18px}

/* WELCOME */
.welcome-bar{background:linear-gradient(135deg,rgba(0,212,255,0.08),rgba(255,209,102,0.06));border:1px solid rgba(0,212,255,0.15);border-radius:var(--radius);padding:18px 24px;display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--gap)}
.welcome-greeting{font-family:'Syne',sans-serif;font-size:20px;font-weight:700}
.welcome-greeting span{color:var(--blue)}
.welcome-date{font-size:12px;color:var(--text2);font-family:'DM Mono',monospace;margin-top:3px}
.welcome-goal-label{font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.1em}
.welcome-goal-value{font-family:'Syne',sans-serif;font-size:18px;font-weight:800;color:var(--gold)}

/* METRICS */
.metrics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--gap);margin-bottom:var(--gap)}
.metric-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;position:relative;overflow:hidden;transition:all .2s}
.metric-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.metric-card.blue::before{background:linear-gradient(90deg,var(--blue),transparent)}
.metric-card.gold::before{background:linear-gradient(90deg,var(--gold),transparent)}
.metric-card.green::before{background:linear-gradient(90deg,var(--green),transparent)}
.metric-card.purple::before{background:linear-gradient(90deg,var(--purple),transparent)}
.metric-card:hover{border-color:var(--border2);transform:translateY(-2px)}
.metric-icon{font-size:20px;margin-bottom:10px}
.metric-label{font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:7px}
.metric-value{font-family:'Syne',sans-serif;font-size:26px;font-weight:800;line-height:1}
.metric-value.blue{color:var(--blue)}.metric-value.gold{color:var(--gold)}.metric-value.green{color:var(--green)}.metric-value.purple{color:var(--purple)}
.metric-trend{font-size:11px;color:var(--text2);margin-top:7px;display:flex;align-items:center;gap:4px}
.trend-up{color:var(--green)}.trend-down{color:var(--red)}
.progress-bar-wrap{margin-top:9px;background:var(--surface2);border-radius:4px;height:4px;overflow:hidden}
.progress-bar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--blue),var(--gold));transition:width .8s ease}

/* DASHBOARD GRID */
.dashboard-grid{display:grid;grid-template-columns:1fr 360px;gap:var(--gap)}
.activity-feed{max-height:300px;overflow-y:auto}
.activity-feed::-webkit-scrollbar{width:3px}
.activity-feed::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}
.activity-item{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);align-items:flex-start}
.activity-item:last-child{border-bottom:none}
.activity-dot{width:7px;height:7px;border-radius:50%;background:var(--blue);margin-top:5px;flex-shrink:0}
.activity-dot.gold{background:var(--gold)}.activity-dot.green{background:var(--green)}
.activity-text{font-size:12px;color:var(--text);flex:1}
.activity-time{font-size:10px;color:var(--text3);font-family:'DM Mono',monospace;white-space:nowrap}
.priorities-list{list-style:none}
.priority-item{display:flex;align-items:center;gap:9px;padding:9px 11px;background:var(--surface2);border-radius:var(--radius-sm);margin-bottom:7px;cursor:pointer;transition:all .15s}
.priority-item:hover{background:rgba(255,255,255,0.07)}
.priority-item.done .priority-text{text-decoration:line-through;color:var(--text3)}
.priority-check{width:16px;height:16px;border:2px solid var(--border2);border-radius:4px;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .15s;font-size:10px}
.priority-item.done .priority-check{background:var(--blue);border-color:var(--blue)}
.priority-text{font-size:12px;flex:1}
.add-btn{width:100%;padding:9px;border:1px dashed var(--border2);border-radius:var(--radius-sm);background:none;color:var(--text2);font-size:12px;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif;margin-top:4px}
.add-btn:hover{border-color:var(--blue);color:var(--blue)}

/* KANBAN */
.kanban-board{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap)}
.kanban-col{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px}
.kanban-col-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.kanban-col-title{font-family:'Syne',sans-serif;font-weight:700;font-size:13px}
.kanban-count{background:var(--surface2);border-radius:20px;padding:2px 9px;font-size:11px;color:var(--text2);font-family:'DM Mono',monospace}
.task-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;margin-bottom:9px;cursor:pointer;transition:all .15s}
.task-card:hover{border-color:var(--border2);transform:translateY(-1px)}
.task-title{font-size:12px;font-weight:600;margin-bottom:5px}
.task-desc{font-size:11px;color:var(--text2);margin-bottom:9px;line-height:1.5}
.task-footer{display:flex;justify-content:space-between;align-items:center}
.priority-badge{font-size:9px;font-weight:600;padding:2px 7px;border-radius:4px;text-transform:uppercase;letter-spacing:.05em}
.priority-badge.high{background:rgba(255,91,91,0.15);color:var(--red)}
.priority-badge.medium{background:rgba(255,209,102,0.15);color:var(--gold)}
.priority-badge.low{background:rgba(61,220,132,0.15);color:var(--green)}
.task-date{font-size:10px;color:var(--text3);font-family:'DM Mono',monospace}

/* TIMELINE */
.timeline{position:relative;padding-left:36px}
.timeline::before{content:'';position:absolute;left:10px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--blue),var(--gold),transparent)}
.phase{position:relative;margin-bottom:36px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:22px;transition:all .2s}
.phase.current{border-color:rgba(0,212,255,0.3);box-shadow:0 0 20px rgba(0,212,255,0.07)}
.phase::before{content:'';position:absolute;left:-30px;top:26px;width:11px;height:11px;border-radius:50%;background:var(--blue);box-shadow:0 0 10px var(--blue-glow);border:2px solid var(--bg)}
.phase.done::before{background:var(--green);box-shadow:0 0 10px rgba(61,220,132,0.4)}
.phase.future::before{background:var(--text3);box-shadow:none}
.phase-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.phase-title{font-family:'Syne',sans-serif;font-weight:700;font-size:15px}
.phase-dates{font-size:11px;color:var(--text2);font-family:'DM Mono',monospace}
.phase-badge{font-size:10px;font-weight:600;padding:3px 9px;border-radius:20px;text-transform:uppercase;letter-spacing:.08em}
.phase-badge.current{background:var(--blue-dim);color:var(--blue)}
.phase-badge.done{background:rgba(61,220,132,0.15);color:var(--green)}
.phase-badge.upcoming{background:var(--surface2);color:var(--text2)}
.phase-desc{font-size:12px;color:var(--text2);line-height:1.6;margin-bottom:14px}
.milestone-list{list-style:none;display:flex;flex-direction:column;gap:7px}
.milestone{display:flex;align-items:center;gap:9px;font-size:12px}
.milestone.done{color:var(--text2)}.milestone.pending{color:var(--text)}

/* REVENUE */
.revenue-grid{display:grid;grid-template-columns:280px 1fr;gap:var(--gap);margin-bottom:var(--gap)}
.chart-bars{display:flex;align-items:flex-end;gap:10px;height:140px;padding:0 6px}
.chart-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:7px}
.chart-bar{width:100%;border-radius:5px 5px 0 0;background:linear-gradient(180deg,var(--blue),rgba(0,212,255,0.3));transition:height .8s ease;min-height:4px}
.chart-bar.gold{background:linear-gradient(180deg,var(--gold),rgba(255,209,102,0.3))}
.chart-label{font-size:10px;color:var(--text2);font-family:'DM Mono',monospace}
.chart-val{font-size:9px;color:var(--text3);font-family:'DM Mono',monospace}
.agents-pnl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap);margin-bottom:var(--gap)}
.agent-pnl-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;position:relative;overflow:hidden}
.agent-pnl-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.agent-pnl-card.crisp::before{background:linear-gradient(90deg,var(--blue),transparent)}
.agent-pnl-card.blade::before{background:linear-gradient(90deg,var(--gold),transparent)}
.agent-pnl-card.oracle::before{background:linear-gradient(90deg,var(--purple),transparent)}
.agent-pnl-name{font-family:'Syne',sans-serif;font-weight:700;font-size:14px;margin-bottom:3px}
.agent-pnl-role{font-size:11px;color:var(--text2);margin-bottom:14px}
.agent-pnl-val{font-family:'DM Mono',monospace;font-size:22px;font-weight:500}
.agent-pnl-val.pos{color:var(--green)}.agent-pnl-val.neg{color:var(--red)}
.agent-pnl-stats{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:12px}
.agent-pnl-stat{background:var(--surface2);border-radius:7px;padding:7px 9px}
.agent-pnl-stat-label{font-size:9px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em}
.agent-pnl-stat-val{font-size:12px;font-weight:600;font-family:'DM Mono',monospace;margin-top:2px}
.clients-list{display:flex;flex-direction:column;gap:7px}
.client-row{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--surface2);border-radius:var(--radius-sm)}
.client-name{font-size:13px;font-weight:600;flex:1}
.client-mrr{font-family:'DM Mono',monospace;font-size:13px;color:var(--gold)}
.client-delete{color:var(--text3);cursor:pointer;font-size:15px;transition:color .15s}
.client-delete:hover{color:var(--red)}
.projection-card{background:linear-gradient(135deg,rgba(0,212,255,0.06),rgba(255,209,102,0.04));border:1px solid rgba(0,212,255,0.15);border-radius:var(--radius);padding:22px}
.proj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px}
.proj-item{text-align:center}
.proj-label{font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:7px}
.proj-value{font-family:'Syne',sans-serif;font-size:20px;font-weight:800}

/* COMMAND CENTER */
.agents-grid-cc{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap);margin-bottom:var(--gap)}
.agent-card-cc{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;cursor:pointer;transition:all .2s}
.agent-card-cc:hover{border-color:var(--border2);transform:translateY(-2px);box-shadow:0 8px 28px rgba(0,0,0,0.3)}
.agent-avatar{display:flex;align-items:center;justify-content:center;border-radius:12px}
.agent-avatar.blue{background:var(--blue-dim)}.agent-avatar.gold{background:var(--gold-dim)}.agent-avatar.purple{background:rgba(192,132,252,0.15)}.agent-avatar.green{background:rgba(61,220,132,0.15)}
.agent-status-wrap{display:flex;align-items:center;gap:5px}
.agent-status-dot{width:7px;height:7px;border-radius:50%}
.agent-status-dot.online{background:var(--green);box-shadow:0 0 6px var(--green);animation:pulse 2s infinite}
.agent-status-dot.busy{background:var(--gold);box-shadow:0 0 6px var(--gold)}
.agent-status-dot.offline{background:var(--text3)}
.agent-status-text{font-size:11px;color:var(--text2)}
.agent-name{font-family:'Syne',sans-serif;font-weight:700;font-size:15px;margin-bottom:2px}
.agent-role{font-size:11px;color:var(--text2);margin-bottom:12px}
.agent-model{font-size:10px;font-family:'DM Mono',monospace;color:var(--blue);background:var(--blue-dim);padding:2px 7px;border-radius:4px;display:inline-block;margin-bottom:9px}
.decisions-list{display:flex;flex-direction:column;gap:10px}
.decision-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px}
.decision-header{display:flex;justify-content:space-between;margin-bottom:7px}
.decision-question{font-size:12px;font-weight:600}
.decision-date{font-size:10px;color:var(--text3);font-family:'DM Mono',monospace}
.decision-summary{font-size:11px;color:var(--text2);line-height:1.6;margin-bottom:7px}
.decision-agents{display:flex;gap:5px;flex-wrap:wrap}
.decision-agent-tag{font-size:10px;padding:2px 7px;border-radius:4px;background:var(--blue-dim);color:var(--blue);font-family:'DM Mono',monospace}

/* AGENTS TAB */
.ag-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;transition:all .2s}
.ag-card:hover{border-color:var(--border2)}
.ag-card-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
.capper-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px}

/* INTEL */
.daily-brief{background:linear-gradient(135deg,rgba(0,212,255,0.06),rgba(255,209,102,0.04));border:1px solid rgba(0,212,255,0.2);border-radius:var(--radius);padding:22px;margin-bottom:var(--gap)}
.brief-item{display:flex;align-items:flex-start;gap:10px;padding:10px;background:rgba(0,0,0,0.2);border-radius:var(--radius-sm);margin-top:8px}
.brief-title{font-size:12px;font-weight:600;margin-bottom:2px}
.brief-summary{font-size:11px;color:var(--text2);line-height:1.5}
.intel-filters{display:flex;gap:7px;margin-bottom:14px;flex-wrap:wrap}
.filter-btn{padding:5px 12px;border-radius:20px;border:1px solid var(--border);background:none;color:var(--text2);font-size:11px;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif}
.filter-btn:hover{border-color:var(--border2);color:var(--text)}
.filter-btn.active{background:var(--blue-dim);border-color:var(--blue);color:var(--blue)}
.intel-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.intel-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px;transition:all .15s}
.intel-card:hover{border-color:var(--border2)}
.intel-card-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:7px}
.intel-card-title{font-size:12px;font-weight:600;flex:1;margin-right:8px}
.intel-tag{font-size:10px;padding:2px 7px;border-radius:4px;font-family:'DM Mono',monospace;white-space:nowrap}
.intel-tag.ai{background:var(--blue-dim);color:var(--blue)}
.intel-tag.finance{background:var(--gold-dim);color:var(--gold)}
.intel-tag.opportunity{background:rgba(61,220,132,0.15);color:var(--green)}
.intel-tag.trend{background:rgba(192,132,252,0.15);color:var(--purple)}
.intel-tag.forex{background:rgba(255,209,102,0.15);color:var(--gold)}
.intel-summary{font-size:11px;color:var(--text2);line-height:1.6;margin-bottom:9px}
.intel-footer{display:flex;justify-content:space-between;align-items:center}
.intel-source{font-size:10px;color:var(--blue);text-decoration:none}
.intel-source:hover{text-decoration:underline}
.intel-date{font-size:10px;color:var(--text3);font-family:'DM Mono',monospace}
.add-intel-form{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:var(--gap);display:none}
.add-intel-form.open{display:block}

/* BASKETBALL */
.bball-hero{background:linear-gradient(135deg,rgba(255,209,102,0.08),rgba(0,212,255,0.05));border:1px solid rgba(255,209,102,0.15);border-radius:var(--radius);padding:22px 26px;display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--gap)}
.bball-number{font-family:'Syne',sans-serif;font-size:56px;font-weight:800;color:var(--gold);line-height:1;opacity:.6}
.stats-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:var(--gap);margin-bottom:var(--gap)}
.stat-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;text-align:center}
.stat-box-val{font-family:'Syne',sans-serif;font-size:28px;font-weight:800;color:var(--gold)}
.stat-box-label{font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.1em;margin-top:5px}
.stat-box-trend{font-size:10px;color:var(--text3);margin-top:3px;font-family:'DM Mono',monospace}
.bball-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--gap)}
.game-row{display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--surface2);border-radius:var(--radius-sm);margin-bottom:6px}
.game-date{font-family:'DM Mono',monospace;font-size:11px;color:var(--text2);min-width:76px}
.game-matchup{font-size:12px;font-weight:600;flex:1}
.game-location{font-size:11px;color:var(--text2)}
.game-result{font-family:'DM Mono',monospace;font-size:12px;font-weight:600;min-width:50px;text-align:right}
.game-result.w{color:var(--green)}.game-result.l{color:var(--red)}.game-result.upcoming{color:var(--text3)}
.training-goal{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--surface2);border-radius:var(--radius-sm);margin-bottom:7px}
.training-goal-label{flex:1;font-size:12px}
.training-goal-bar{height:5px;background:var(--surface);border-radius:4px;overflow:hidden;flex:1}
.training-goal-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--gold),var(--blue))}
.training-goal-pct{font-size:11px;color:var(--gold);font-family:'DM Mono',monospace;min-width:34px;text-align:right}

/* SLIDE PANEL */
.slide-panel{position:fixed;top:0;right:-480px;width:480px;height:100%;background:rgba(8,8,15,0.96);backdrop-filter:blur(24px);border-left:1px solid var(--border);z-index:200;transition:right .3s ease;overflow-y:auto;padding:28px}
.slide-panel.open{right:0}
.slide-panel-close{position:absolute;top:18px;right:18px;background:var(--surface2);border:none;color:var(--text2);width:30px;height:30px;border-radius:7px;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.slide-panel-close:hover{color:var(--text);background:var(--border2)}
.log-item{background:var(--surface2);border-radius:7px;padding:9px 11px;font-size:11px;color:var(--text2);line-height:1.5;margin-bottom:7px}
.log-item-time{font-family:'DM Mono',monospace;color:var(--text3);font-size:10px;margin-top:3px}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.75);backdrop-filter:blur(8px);z-index:300;display:none;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal{background:#0d0d18;border:1px solid var(--border2);border-radius:var(--radius);padding:26px;width:460px;max-width:90vw;animation:fadeInUp .2s ease}
.modal-title{font-family:'Syne',sans-serif;font-size:17px;font-weight:700;margin-bottom:18px}
.modal-actions{display:flex;gap:9px;margin-top:18px;justify-content:flex-end}

/* FORM */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.form-group{display:flex;flex-direction:column;gap:5px}
.form-group.full{grid-column:1/-1}
.form-label{font-size:10px;color:var(--text2);text-transform:uppercase;letter-spacing:.08em}
.form-input,.form-select,.form-textarea{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 12px;color:var(--text);font-size:12px;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--blue)}
.form-textarea{resize:vertical;min-height:70px}
.form-select option{background:#0d0d18}

/* BUTTONS */
.btn{padding:9px 18px;border-radius:var(--radius-sm);font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif;border:none}
.btn-primary{background:linear-gradient(135deg,var(--blue),#0099cc);color:#050508}
.btn-primary:hover{box-shadow:0 0 14px var(--blue-glow)}
.btn-gold{background:linear-gradient(135deg,var(--gold),#cc9900);color:#050508}
.btn-gold:hover{box-shadow:0 0 14px var(--gold-glow)}
.btn-ghost{background:var(--surface2);color:var(--text2)}
.btn-ghost:hover{color:var(--text)}
.btn-danger{background:rgba(255,91,91,0.15);color:var(--red)}
.btn-danger:hover{background:rgba(255,91,91,0.25)}

/* UTILS */
.flex{display:flex}.flex-between{display:flex;justify-content:space-between;align-items:center}
.gap-2{gap:8px}.gap-3{gap:12px}.mb-4{margin-bottom:16px}.mb-5{margin-bottom:20px}
.text-muted{color:var(--text2);font-size:12px}
.overlay-backdrop{position:fixed;inset:0;z-index:150;display:none}
.overlay-backdrop.open{display:block}

@media(max-width:1200px){
  .metrics-grid{grid-template-columns:repeat(2,1fr)}
  .dashboard-grid{grid-template-columns:1fr}
  .kanban-board{grid-template-columns:1fr}
  .agents-pnl-grid{grid-template-columns:1fr 1fr}
  .stats-grid{grid-template-columns:repeat(3,1fr)}
  .bball-grid{grid-template-columns:1fr}
  .intel-grid{grid-template-columns:1fr}
}
</style>
</head>
