}
function saveRevenueGoal(){
  const d=S.get('revenue')||{goal:10000,months:[],clients:[]};
  d.goal=parseFloat(document.getElementById('m_revGoal').value)||10000;
  const label=document.getElementById('m_monthLabel').value,val=parseFloat(document.getElementById('m_monthVal').value)||0;
  if(label&&val)d.months.push({label,val});
  S.set('revenue',d);renderRevenue();closeModal();
}
function openClientModal(){
  showModal(`<div class="modal-title">+ Add Revenue Stream</div>
    <div class="form-group mb-4"><label class="form-label">Source Name</label><input class="form-input" id="m_clientName" placeholder="e.g. Basketball Contract" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Monthly Amount ($)</label><input class="form-input" id="m_clientMrr" type="number" placeholder="0" style="width:100%"></div>
