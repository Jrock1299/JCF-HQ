function openTrainingModal(){
  showModal(`<div class="modal-title">💪 Add Training Goal</div>
    <div class="form-group mb-4"><label class="form-label">Goal</label><input class="form-input" id="m_tLabel" placeholder="e.g. 3-point shooting accuracy" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Progress (%)</label><input class="form-input" id="m_tPct" type="number" min="0" max="100" value="0" style="width:100%"></div>
    <div class="modal-actions"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-gold" onclick="saveTrainingGoal()">Add</button></div>`);
}
function saveTrainingGoal(){
  const d=S.get('bball')||{};d.training=d.training||[];
  d.training.push({label:document.getElementById('m_tLabel').value,pct:parseInt(document.getElementById('m_tPct').value)||0});
  S.set('bball',d);renderBasketball();closeModal();
}

/* ============================================================
   MODAL HELPERS
   ============================================================ */
function showModal(html){document.getElementById('modalContent').innerHTML=html;document.getElementById('modalOverlay').classList.add('open');}
function closeModal(){document.getElementById('modalOverlay').classList.remove('open');}
document.getElementById('modalOverlay').addEventListener('click',e=>{if(e.target===document.getElementById('modalOverlay'))closeModal();});
document.addEventListener('keydown',e=>{
  if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();document.getElementById('searchInput').focus();}
  if(e.key==='Escape'){closeModal();closePanel();}
});

/* ============================================================
   INIT
   ============================================================ */
function init(){
  updateNetWorth();renderActivityFeed();renderPriorities();renderKanban();renderTimeline();
}
init();
</script>
