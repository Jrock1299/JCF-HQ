function savePick(capperId,capperName){
  const picks=S.get('picks')||[];
  const pick=document.getElementById('m_pPick').value;
  picks.push({id:Date.now().toString(),capper:capperName,capperId,pick,sport:document.getElementById('m_pSport').value,date:document.getElementById('m_pDate').value,result:document.getElementById('m_pResult').value,logged:new Date().toISOString()});
  S.set('picks',picks);renderAgentsTab();closeModal();addActivity('Pick logged: '+pick+' ('+capperName+')');
}
function resolvePick(pickId){
  const picks=S.get('picks')||[];const pick=picks.find(p=>p.id===pickId);if(!pick)return;
  showModal(`<div class="modal-title">Resolve Pick</div>
    <div style="font-size:13px;margin-bottom:18px;color:var(--text2)">${pick.pick} · ${pick.capper}</div>
    <div class="modal-actions" style="justify-content:center;gap:10px">
      <button class="btn" style="background:rgba(61,220,132,.2);color:var(--green);font-size:13px;padding:10px 20px" onclick="setPickResult('${pickId}','W')">✅ Win</button>
      <button class="btn" style="background:rgba(255,91,91,.2);color:var(--red);font-size:13px;padding:10px 20px" onclick="setPickResult('${pickId}','L')">❌ Loss</button>
      <button class="btn btn-ghost" style="font-size:13px;padding:10px 20px" onclick="setPickResult('${pickId}','P')">➡️ Push</button>
    </div>`);
}
function setPickResult(pickId,result){
  const picks=S.get('picks')||[];const idx=picks.findIndex(p=>p.id===pickId);
  if(idx>=0)picks[idx].result=result;S.set('picks',picks);renderAgentsTab();closeModal();
}
function viewCapperPicks(capperId,capperName){
  const picks=S.get('picks')||[];const cp=picks.filter(p=>p.capperId===capperId).reverse();
  showModal(`<div class="modal-title">📊 ${capperName} — History</div>
    <div style="max-height:380px;overflow-y:auto">
      ${cp.length?cp.map(p=>`<div style="display:flex;align-items:center;gap:9px;padding:9px;background:var(--surface2);border-radius:7px;margin-bottom:5px"><div>${p.result==='W'?'✅':p.result==='L'?'❌':p.result==='P'?'➡️':'⏳'}</div><div style="flex:1"><div style="font-size:12px;font-weight:600">${p.pick}</div><div style="font-size:10px;color:var(--text2)">${p.sport} · ${p.date}</div></div></div>`).join(''):'<div style="color:var(--text3);padding:16px">No picks logged yet</div>'}
    </div>
