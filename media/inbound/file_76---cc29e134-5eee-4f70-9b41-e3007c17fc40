function renderAgentsTab(){
  const agents=S.get('agents_v2')||DEFAULT_AGENTS_V2;
  const cappers=S.get('cappers')||[];
  const picks=S.get('picks')||[];

  document.getElementById('agentCardsGrid').innerHTML=agents.map((a,i)=>`
