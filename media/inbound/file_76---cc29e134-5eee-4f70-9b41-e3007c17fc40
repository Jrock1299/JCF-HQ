<script>
/* ============================================================
   STORAGE
   ============================================================ */
const S={get:k=>{try{return JSON.parse(localStorage.getItem('jcf_'+k))}catch(e){return null}},set:(k,v)=>localStorage.setItem('jcf_'+k,JSON.stringify(v))};

/* ============================================================
   NAV
   ============================================================ */
function switchTab(tab,el){
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('tab-'+tab).classList.add('active');
  el.classList.add('active');
  if(tab==='revenue')renderRevenue();
  if(tab==='command')renderCommand();
  if(tab==='agents')renderAgentsTab();
  if(tab==='intel')renderIntel();
  if(tab==='basketball')renderBasketball();
}

/* ============================================================
   CLOCK
   ============================================================ */
function updateClock(){
  const now=new Date(),h=now.getHours();
  document.getElementById('timeOfDay').textContent=h<12?'morning':h<17?'afternoon':'evening';
  document.getElementById('liveDate').textContent=now.toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'})+' · '+now.toLocaleTimeString();
  const daysLeft=Math.ceil((new Date('2030-01-01')-now)/86400000);
  document.getElementById('daysLeft').textContent=daysLeft.toLocaleString();
}
setInterval(updateClock,1000);updateClock();

/* ============================================================
   NET WORTH
   ============================================================ */
function updateNetWorth(){
  const d=S.get('networth')||{current:0,goal:10000000};
  const pct=Math.min(100,(d.current/d.goal)*100);
  const fmt=n=>n>=1000000?'$'+(n/1e6).toFixed(2)+'M':n>=1000?'$'+(n/1000).toFixed(1)+'K':'$'+n;
  document.getElementById('nwPct').textContent=pct.toFixed(1)+'%';
  document.getElementById('nwBar').style.width=pct+'%';
  document.getElementById('netWorthDisplay').textContent=fmt(d.current)+' / '+fmt(d.goal);
}
function openNetWorthModal(){
  const d=S.get('networth')||{current:0,goal:10000000};
  showModal(`<div class="modal-title">💎 Net Worth Tracker</div>
    <div class="form-group mb-4"><label class="form-label">Current Net Worth ($)</label><input class="form-input" id="m_nwCurrent" value="${d.current}" type="number" style="width:100%"></div>
    <div class="form-group"><label class="form-label">Goal ($)</label><input class="form-input" id="m_nwGoal" value="${d.goal}" type="number" style="width:100%"></div>
    <div class="modal-actions"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveNetWorth()">Save</button></div>`);
}
function saveNetWorth(){
  S.set('networth',{current:parseFloat(document.getElementById('m_nwCurrent').value)||0,goal:parseFloat(document.getElementById('m_nwGoal').value)||10000000});
  updateNetWorth();closeModal();
}

/* ============================================================
   ACTIVITY FEED
   ============================================================ */
function renderActivityFeed(){
  const items=S.get('activity')||[
    {text:'JCF HQ v2 — Mission Control online',time:new Date().toISOString(),color:'blue'},
    {text:'Crisp & Blade paper trading sessions configured',time:new Date().toISOString(),color:'gold'},
    {text:'Oracle intelligence system activated',time:new Date().toISOString(),color:'green'},
  ];
  document.getElementById('activityFeed').innerHTML=items.slice(-20).reverse().map(i=>`
    <div class="activity-item"><div class="activity-dot ${i.color||'blue'}"></div><div class="activity-text">${i.text}</div><div class="activity-time">${timeAgo(i.time)}</div></div>`).join('');
}
function addActivity(text){
  if(!text){const t=prompt('New activity:');if(!t)return;text=t;}
  const items=S.get('activity')||[];
  items.push({text,time:new Date().toISOString(),color:'blue'});
  S.set('activity',items);renderActivityFeed();
}
function timeAgo(iso){
  const d=Date.now()-new Date(iso);
  if(d<60000)return'just now';if(d<3600000)return Math.floor(d/60000)+'m ago';
  if(d<86400000)return Math.floor(d/3600000)+'h ago';return Math.floor(d/86400000)+'d ago';
}

/* ============================================================
   PRIORITIES
   ============================================================ */
function renderPriorities(){
  const items=S.get('priorities')||[{text:'Review trading session results',done:false},{text:'Check Oracle intelligence report',done:false},{text:'Training session — shooting drills',done:false}];
  document.getElementById('prioritiesList').innerHTML=items.map((item,i)=>`
    <li class="priority-item ${item.done?'done':''}" onclick="togglePriority(${i})">
      <div class="priority-check">${item.done?'✓':''}</div>
      <span class="priority-text">${item.text}</span>
    </li>`).join('');
  document.getElementById('prioritiesCount').textContent=items.filter(i=>!i.done).length;
}
function togglePriority(i){const items=S.get('priorities')||[];items[i].done=!items[i].done;S.set('priorities',items);renderPriorities();}
function addPriority(){const t=prompt('New priority:');if(!t)return;const items=S.get('priorities')||[];items.push({text:t,done:false});S.set('priorities',items);renderPriorities();}

/* ============================================================
   KANBAN
   ============================================================ */
function renderKanban(){
  const tasks=S.get('tasks')||[];
  ['backlog','inprogress','done'].forEach(col=>{
    const ct=tasks.filter(t=>t.status===col);
    document.getElementById('tasks-'+col).innerHTML=ct.map(t=>`
      <div class="task-card" onclick="editTask('${t.id}')">
        <div class="task-title">${t.title}</div>
        <div class="task-desc">${t.desc||''}</div>
        <div class="task-footer"><span class="priority-badge ${t.priority}">${t.priority}</span><span class="task-date">${t.created?new Date(t.created).toLocaleDateString():''}</span></div>
      </div>`).join('');
    document.getElementById('count-'+col).textContent=ct.length;
  });
  document.getElementById('activeProjectsCount').textContent=tasks.filter(t=>t.status==='inprogress').length;
}
function openTaskModal(status='backlog'){
  showModal(`<div class="modal-title">📋 New Task</div>
    <div class="form-group mb-4"><label class="form-label">Title</label><input class="form-input" id="m_taskTitle" placeholder="Task title" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Description</label><textarea class="form-textarea" id="m_taskDesc" style="width:100%"></textarea></div>
    <div class="form-group mb-4"><label class="form-label">Priority</label><select class="form-select" id="m_taskPriority" style="width:100%"><option value="high">🔴 High</option><option value="medium" selected>🟡 Medium</option><option value="low">🟢 Low</option></select></div>
    <div class="form-group mb-4"><label class="form-label">Status</label><select class="form-select" id="m_taskStatus" style="width:100%"><option value="backlog" ${status==='backlog'?'selected':''}>Backlog</option><option value="inprogress" ${status==='inprogress'?'selected':''}>In Progress</option><option value="done" ${status==='done'?'selected':''}>Done</option></select></div>
    <div class="modal-actions"><button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveTask()">Add Task</button></div>`);
}
function saveTask(id){
  const tasks=S.get('tasks')||[];
  const task={id:id||Date.now().toString(),title:document.getElementById('m_taskTitle').value||'Untitled',desc:document.getElementById('m_taskDesc').value,priority:document.getElementById('m_taskPriority').value,status:document.getElementById('m_taskStatus').value,created:new Date().toISOString()};
  if(id){const idx=tasks.findIndex(t=>t.id===id);if(idx>=0)tasks[idx]=task;}else tasks.push(task);
  S.set('tasks',tasks);renderKanban();closeModal();
}
function editTask(id){
  const tasks=S.get('tasks')||[];const t=tasks.find(t=>t.id===id);if(!t)return;
  showModal(`<div class="modal-title">✏️ Edit Task</div>
    <div class="form-group mb-4"><label class="form-label">Title</label><input class="form-input" id="m_taskTitle" value="${t.title}" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Description</label><textarea class="form-textarea" id="m_taskDesc" style="width:100%">${t.desc||''}</textarea></div>
    <div class="form-group mb-4"><label class="form-label">Priority</label><select class="form-select" id="m_taskPriority" style="width:100%"><option value="high" ${t.priority==='high'?'selected':''}>🔴 High</option><option value="medium" ${t.priority==='medium'?'selected':''}>🟡 Medium</option><option value="low" ${t.priority==='low'?'selected':''}>🟢 Low</option></select></div>
    <div class="form-group mb-4"><label class="form-label">Status</label><select class="form-select" id="m_taskStatus" style="width:100%"><option value="backlog" ${t.status==='backlog'?'selected':''}>Backlog</option><option value="inprogress" ${t.status==='inprogress'?'selected':''}>In Progress</option><option value="done" ${t.status==='done'?'selected':''}>Done</option></select></div>
    <div class="modal-actions"><button class="btn btn-danger" onclick="deleteTask('${id}')">Delete</button><button class="btn btn-ghost" onclick="closeModal()">Cancel</button><button class="btn btn-primary" onclick="saveTask('${id}')">Save</button></div>`);
}
function deleteTask(id){let tasks=S.get('tasks')||[];tasks=tasks.filter(t=>t.id!==id);S.set('tasks',tasks);renderKanban();closeModal();}

