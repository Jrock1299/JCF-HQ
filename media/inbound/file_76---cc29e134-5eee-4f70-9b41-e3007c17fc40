function saveClient(){
  const d=S.get('revenue')||{goal:10000,months:[],clients:[]};
  d.clients=d.clients||[];d.clients.push({name:document.getElementById('m_clientName').value||'Stream',mrr:parseFloat(document.getElementById('m_clientMrr').value)||0});
  S.set('revenue',d);renderRevenue();closeModal();
}
function deleteClient(i){const d=S.get('revenue')||{};d.clients.splice(i,1);S.set('revenue',d);renderRevenue();}

