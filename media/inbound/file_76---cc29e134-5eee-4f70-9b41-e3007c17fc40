/* ============================================================
   REVENUE
   ============================================================ */
function renderRevenue(){
  const data=S.get('revenue')||{goal:10000,months:[],clients:[]};
  const mrr=(data.clients||[]).reduce((s,c)=>s+(c.mrr||0),0);
  const goal=data.goal||10000;
  const pct=Math.min(100,(mrr/goal)*100);
  document.getElementById('gaugePct').textContent=pct.toFixed(0)+'%';
  document.getElementById('gaugeArc').style.strokeDashoffset=390-(390*pct/100);
  document.getElementById('mrrDisplay').textContent='$'+mrr.toLocaleString();
  document.getElementById('goalDisplay').textContent='$'+goal.toLocaleString();
  const months=data.months||[];
  const maxVal=Math.max(...months.map(m=>m.val),1);
  document.getElementById('revChart').innerHTML=months.slice(-6).map((m,i)=>`
    <div class="chart-bar-wrap">
      <div class="chart-val">$${m.val>=1000?(m.val/1000).toFixed(1)+'K':m.val}</div>
      <div class="chart-bar ${i===months.length-1?'gold':''}" style="height:${Math.max(6,(m.val/maxVal)*120)}px"></div>
      <div class="chart-label">${m.label}</div>
    </div>`).join('')||'<div style="color:var(--text3);font-size:12px;padding:20px">No revenue data yet</div>';
  document.getElementById('clientsList').innerHTML=(data.clients||[]).map((c,i)=>`
    <div class="client-row"><div class="client-name">${c.name}</div><div class="client-mrr">$${c.mrr.toLocaleString()}/mo</div><div class="client-delete" onclick="deleteClient(${i})">✕</div></div>`).join('')||'<div style="color:var(--text3);font-size:12px;padding:12px">No revenue streams added yet</div>';
  const annual=mrr*12;
  document.getElementById('projAnnual').textContent='$'+annual.toLocaleString();
  document.getElementById('projGrowth').textContent=mrr>0?'$'+Math.max(0,goal-mrr).toLocaleString()+'/mo needed':'Add revenue';
  if(mrr>0){const d=new Date();d.setMonth(d.getMonth()+Math.ceil((goal*12-annual)/mrr));document.getElementById('projDate').textContent=d.toLocaleDateString('en-US',{month:'short',year:'numeric'});}
  else document.getElementById('projDate').textContent='—';
}
function openRevenueGoalModal(){
  const d=S.get('revenue')||{goal:10000};
  showModal(`<div class="modal-title">💰 Set Revenue Goal</div>
    <div class="form-group mb-4"><label class="form-label">Monthly Revenue Goal ($)</label><input class="form-input" id="m_revGoal" value="${d.goal}" type="number" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Add Month Label</label><input class="form-input" id="m_monthLabel" placeholder="e.g. Mar 2026" style="width:100%"></div>
    <div class="form-group mb-4"><label class="form-label">Month Revenue ($)</label><input class="form-input" id="m_monthVal" type="number" placeholder="0" style="width:100%"></div>
