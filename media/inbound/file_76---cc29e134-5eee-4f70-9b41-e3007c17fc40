      <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px">${a.skills.map(s=>`<span style="background:var(--surface2);border-radius:5px;padding:3px 8px;font-size:10px;color:var(--text2)">${s}</span>`).join('')}</div>
      <button class="btn btn-ghost" style="width:100%;font-size:11px" onclick="editAgentTask(${i})">Update Task / Status</button>
    </div>`).join('');

  const capperStats=cappers.map(c=>{
    const cp=picks.filter(p=>p.capperId===c.id);
    const wins=cp.filter(p=>p.result==='W').length;
    const losses=cp.filter(p=>p.result==='L').length;
    const pushes=cp.filter(p=>p.result==='P').length;
    const total=wins+losses;
    const wp=total>0?((wins/total)*100).toFixed(0):0;
    return{...c,wins,losses,pushes,total,winPct:wp};
  });

  document.getElementById('capperGrid').innerHTML=capperStats.length?capperStats.map((c,i)=>`
    <div class="capper-card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px">
        <div><div style="font-family:'Syne',sans-serif;font-weight:700;font-size:15px">${c.name}</div><div style="font-size:11px;color:var(--text2);margin-top:2px">${c.sport} · ${c.platform||'Telegram'}</div></div>
        <div style="text-align:right"><div style="font-family:'Syne',sans-serif;font-size:22px;font-weight:800;color:${parseInt(c.winPct)>=55?'var(--green)':parseInt(c.winPct)>=50?'var(--gold)':'var(--red)'}">${c.winPct}%</div><div style="font-size:10px;color:var(--text3)">win rate</div></div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:12px">
        <div style="background:rgba(61,220,132,.1);border-radius:7px;padding:7px;text-align:center"><div style="font-family:'DM Mono',monospace;font-size:16px;font-weight:600;color:var(--green)">${c.wins}</div><div style="font-size:9px;color:var(--text3)">W</div></div>
        <div style="background:rgba(255,91,91,.1);border-radius:7px;padding:7px;text-align:center"><div style="font-family:'DM Mono',monospace;font-size:16px;font-weight:600;color:var(--red)">${c.losses}</div><div style="font-size:9px;color:var(--text3)">L</div></div>
        <div style="background:var(--surface2);border-radius:7px;padding:7px;text-align:center"><div style="font-family:'DM Mono',monospace;font-size:16px;font-weight:600;color:var(--text2)">${c.pushes}</div><div style="font-size:9px;color:var(--text3)">P</div></div>
      </div>
      <div style="font-size:11px;color:var(--text3);margin-bottom:10px">${c.total} picks · ${c.notes||'No notes'}</div>
      <div style="display:flex;gap:7px">
        <button class="btn btn-primary" style="flex:1;font-size:11px;padding:6px" onclick="openLogPickModal('${c.id}','${c.name}')">+ Log Pick</button>
        <button class="btn btn-ghost" style="font-size:11px;padding:6px" onclick="viewCapperPicks('${c.id}','${c.name}')">History</button>
        <button class="btn btn-danger" style="font-size:11px;padding:6px" onclick="deleteCapper(${i})">✕</button>
      </div>
    </div>`).join(''):'<div style="color:var(--text3);font-size:12px;padding:16px">No cappers added yet</div>';

  const recentPicks=[...picks].reverse().slice(0,15);
  document.getElementById('recentPicksFeed').innerHTML=recentPicks.length?recentPicks.map(p=>`
    <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--surface2);border-radius:7px;margin-bottom:5px">
      <div style="font-size:13px">${p.result==='W'?'✅':p.result==='L'?'❌':p.result==='P'?'➡️':'⏳'}</div>
      <div style="flex:1"><div style="font-size:12px;font-weight:600">${p.pick}</div><div style="font-size:10px;color:var(--text2)">${p.capper} · ${p.sport} · ${p.date}</div></div>
