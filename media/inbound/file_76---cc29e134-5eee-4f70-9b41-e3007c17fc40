      ${(!p.result||p.result==='PENDING')?`<button onclick="resolvePick('${p.id}')" style="font-size:10px;padding:3px 7px;border-radius:4px;background:var(--surface);border:1px solid var(--border);color:var(--text2);cursor:pointer">Resolve</button>`:''}
    </div>`).join(''):'<div style="color:var(--text3);font-size:12px;padding:12px">No picks logged yet</div>';
}

